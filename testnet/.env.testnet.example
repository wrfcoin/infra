# Fleet chain identity; keep 777 until the owner cut.
WRFCOIN_CHAIN_ID=777
# Testnet validation floor; retain 0 for the public chain 888 too.
WRFCOIN_MIN_WORK_FACTOR=0

# Operator-owned absolute roots. Replace both placeholders before use.
# Existing WRFCOIN_ROOT/CORE4_PATH overrides still take precedence.
WRFCOIN_DEPLOY_ROOT=/path/to/wrfcoin-deploy
WRFCOIN_SRC_ROOT=/path/to/wrfcoin-src

# ==============================================================================
# WRFCoin Testnet — Environment Variables
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.
#
# Generate strong random secrets with:
#   openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (Required)
# ------------------------------------------------------------------------------

# PostgreSQL password for the wrfcoin database user
# MUST be URL-safe (no + / =) — used in DATABASE_URL.
# Required — deployment fails if not set
POSTGRES_PASSWORD=REPLACE_with_strong_password

# PostgreSQL base-backup retention count (used by scripts/pg-basebackup.sh).
# Default: keep the newest 3 base backups.
PG_BASEBACKUP_KEEP_COUNT=3

# PostgreSQL WAL archive retention window in days (used by scripts/pg-basebackup.sh).
# Default: prune archived WAL files older than 7 days.
PG_WAL_RETENTION_DAYS=7

# ------------------------------------------------------------------------------
# Cache (Required)
# ------------------------------------------------------------------------------

# Redis authentication password
# MUST be URL-safe (no + / =) — used in REDIS_URL.
# Required — deployment fails if not set
REDIS_PASSWORD=REPLACE_with_strong_password

# Redis key prefix for namespace isolation.
# Each microservice uses a unique prefix to prevent key collisions.
# Defaults are set per-service in docker-compose.testnet.yml:
#   backend: "backend:", wallet: "wallet:", governance: "governance:",
#   iot: "iot:", earnings: "earnings:"
# Override only if you need a custom prefix scheme.
# REDIS_PREFIX=backend:

# ------------------------------------------------------------------------------
# Security (Required)
# ------------------------------------------------------------------------------

# JWT signing secret for the Node.js backend API (user authentication).
# NOT used by the blockchain node — the node uses WRFCOIN_*_TOKEN vars below.
# Generate: openssl rand -hex 32
# Required
JWT_SECRET=REPLACE_with_strong_secret_min_32_chars

# HMAC secret for OAuth state tokens (CSRF protection on OAuth login callbacks).
# If missing, the backend falls back to an insecure dev value — not acceptable
# for testnet because callbacks are reachable from the public internet.
# Generate: openssl rand -hex 32
# Required
OAUTH_STATE_SECRET=REPLACE_with_strong_secret_min_32_chars

# API key encryption secret (AES-256-GCM) for securing stored API keys.
# Generate with: openssl rand -hex 32
# Required — backend services will fail to encrypt/decrypt API keys without this.
API_KEY_ENCRYPTION_KEY=REPLACE_with_hex_32_bytes

# Key-manager secret for the backend /api/keys route family (backend#1318).
# Generate with: openssl rand -hex 32. Unset = /api/keys stays unmounted (fail-closed).
ENCRYPTION_KEY=REPLACE_with_hex_32_bytes

# RPC API key required by services that call protected node RPC endpoints.
# Generate: openssl rand -hex 32
RPC_API_KEY=REPLACE_with_strong_token

# Admin token for privileged operator/admin endpoints.
# Generate: openssl rand -hex 32
ADMIN_TOKEN=REPLACE_with_strong_admin_token

# Shared secret accepted by the n8n webhook carve-out. Requests without this
# value must use the normal authenticated admin path; an unset value fails closed.
# Generate: openssl rand -hex 32
N8N_WEBHOOK_SECRET=REPLACE_with_strong_webhook_secret

# Tailscale tailnet bind address for the block explorer (#552/#557).
# Default loopback (127.0.0.1) keeps every HTTP surface CT-local. Set this to
# the HOST's Tailscale IP (the 100.x.y.z address from `tailscale ip -4`) to
# expose the EXPLORER (:8081) to the tailnet ONLY — never the public internet.
# This var rebinds the explorer and nothing else (enforced by compose smoke
# check C4); other services have their own explicit per-service opt-ins
# (WRFCOIN_BACKEND_BIND_ADDR, FAUCET_TAILNET_BIND_ADDR below) so exposing one
# surface never silently exposes another. Operator/metrics ports (Prometheus,
# Grafana, Alertmanager, exporters) stay on loopback regardless. The P2P port
# (9000) is and remains public.
# Example:
#   TESTNET_TAILNET_BIND_ADDR=<NODE_TAILNET_IP>
TESTNET_TAILNET_BIND_ADDR=127.0.0.1

# Faucet UI host bind for port 8080 (seed profile) — per-service opt-in (#588).
# Set to the CT's Tailscale IP to let tailnet-joined testers claim test WRF
# (JOIN_TESTNET.md "Getting test WRF"). Deliberately independent of
# TESTNET_TAILNET_BIND_ADDR so an explorer-only exposure never includes the
# faucet. Never set to a public-internet address without an explicit operator
# decision — the faucet's rate limits are not DDoS protection.
# FAUCET_TAILNET_BIND_ADDR=<NODE_TAILNET_IP>

# Backend API host bind for port 4001 — per-service override (#546).
# Takes precedence over TESTNET_TAILNET_BIND_ADDR for the backend ONLY. Leave
# unset (commented) to inherit the tailnet bind above. Set to a LAN/Tailscale
# address or 0.0.0.0 for a deliberate one-off mobile validation window, then
# redeploy only the backend service during an approved operator window.
# WRFCOIN_BACKEND_BIND_ADDR=127.0.0.1

# Grafana admin dashboard password (dashboard on port 3100)
# Required
GRAFANA_ADMIN_PASSWORD=REPLACE_with_strong_password

# ------------------------------------------------------------------------------
# AlertManager notifications
# ------------------------------------------------------------------------------

# Webhook AlertManager posts critical notifications to (infra#627). This is the
# ONLY critical delivery channel — email/SMTP was removed (no MTA in CT 101).
# Default is the alert-receiver service DNS name, which the standard bring-up
# starts (docker-compose.alert-receiver.yml, now included in the override).
# Override only for a host-run receiver or your own Discord/Slack-compatible URL.
ALERTMANAGER_WEBHOOK_URL=http://wrfcoin-alert-receiver:19093/alerts

# Human paging channel for the webhook receiver (infra#601 / #627). The webhook
# receiver forwards a compact summary of every critical notification here — this
# is what actually reaches an operator's phone. LEAVE THIS BLANK AND NO CRITICAL
# ALERT REACHES A HUMAN: set it to a real ntfy topic or Telegram bot URL before
# launch (the live .env must carry the real secret; do NOT commit it here).
#   ntfy:     ALERT_FORWARD_URL=https://ntfy.sh/<your-private-topic>
#             ALERT_FORWARD_FORMAT=ntfy
#   telegram: ALERT_FORWARD_URL=https://api.telegram.org/bot<token>/sendMessage?chat_id=<chat_id>
#             ALERT_FORWARD_FORMAT=telegram
#   generic:  any Slack-incoming-webhook-compatible endpoint (default format)
ALERT_FORWARD_URL=            # REQUIRED for launch — ntfy topic or Telegram bot URL (real secret in live .env)
ALERT_FORWARD_FORMAT=ntfy
# Only needed for telegram when chat_id is not embedded in ALERT_FORWARD_URL.
ALERT_FORWARD_TELEGRAM_CHAT_ID=
# Per-forward HTTP timeout for the alert-receiver (seconds).
ALERT_FORWARD_TIMEOUT_SECS=10

# NOTE: AlertManager email/SMTP support was removed in infra#627. CT 101 has no
# MTA, so the old `smtp_smarthost: localhost:25` path delivered nowhere and
# silently swallowed every critical page. If a reachable smarthost is ever
# provisioned, re-add an email receiver to alertmanager.yml and reintroduce the
# ALERTMANAGER_SMTP_* / ALERTMANAGER_OPERATOR_EMAILS vars here.

# ------------------------------------------------------------------------------
# Monitoring Authentication (Generated by setup-env.sh)
# ------------------------------------------------------------------------------

# Prometheus web UI admin password (used for basic auth).
# setup-env.sh generates this AND creates prometheus-web.yml with the bcrypt hash.
# After enabling, update Grafana's Prometheus datasource to include basic auth
# (username: admin, password: this value).
PROMETHEUS_ADMIN_PASSWORD=REPLACE_with_strong_password

# Bearer token sent by Prometheus when scraping /metrics endpoints.
# The node/backend don't validate this yet — pre-configured for when they add auth.
PROMETHEUS_BEARER_TOKEN=REPLACE_with_strong_token

# ------------------------------------------------------------------------------
# Node Authentication (Required)
# ------------------------------------------------------------------------------

# Full local image ID from: docker image inspect --format '{{.Id}}' wrfcoin/native-chain:testnet-local
# Public-release setup rejects placeholders, tags, uppercase, and short IDs.
WRFCOIN_TESTNET_RUNTIME_IMAGE=sha256:REPLACE_WITH_RUNTIME_IMAGE_ID
WRFCOIN_RUNTIME_IMAGE_PROFILE=public-release
WRFCOIN_RUNTIME_IMAGE_CLASS=IMMUTABLE

# Operator token used by the backend when making authenticated calls to the
# blockchain node API. Required: release launch_api exits when no operator token
# is configured.
WRFCOIN_OPERATOR_TOKEN=REPLACE_with_strong_token

# Dedicated contributor token accepted by the blockchain node API and used by
# the backend wallet relay. Required; do not reuse WRFCOIN_OPERATOR_TOKEN.
WRFCOIN_CONTRIBUTOR_TOKEN=REPLACE_with_distinct_strong_contributor_token

# Oracle token accepted by the blockchain node API.
# Leave empty to disable oracle token authentication.
WRFCOIN_ORACLE_TOKEN=

# Reader token accepted by the blockchain node API.
# Leave empty to disable reader token authentication.
WRFCOIN_READER_TOKEN=

# Hex-encoded snapshot signing private key for signed state snapshots.
# Leave empty to publish unsigned snapshots.
WRFCOIN_SNAPSHOT_SIGNER_PRIVATE_KEY=

# Comma-separated 64-hex ed25519 public keys trusted for snapshot ingest.
# MUST equal WRFCOIN_CUT_SNAPSHOT_TRUSTED_SIGNERS in testnet/cut-pins.env, which
# is the source of truth. The value below is that pin, a PUBLIC key: the
# attested YubiKey 9C snapshot signer (testnet/ceremony/snapshot-signer-9c/). It
# is not a secret. If cut-pins.env changes, copy the new value here; never
# invent or generate one. check-env-completeness.sh ERRORs when this is absent or
# differs from the pin (infra#1080). core4 then refuses every ingest: an empty
# list returns 503 SNAPSHOT_TRUST_NOT_CONFIGURED, and a different key returns 422.
WRFCOIN_SNAPSHOT_TRUSTED_SIGNERS=14f423fa3894a4ccc37730f4c588e41e8bb1ed38dc7280685e78c02c36a748e9

# Host directory the funnel edge serves at /join/* (infra#1057). Resolved by
# Compose only; publish-join-snapshot.sh writes to the running edge's mount. Must be absolute and OUTSIDE the deploy/release tree, or
# a release flip empties it. Empty = /var/lib/wrfcoin-testnet-join/public.
WRFCOIN_JOIN_SNAPSHOT_DIR=

# Contributor address used for weather data submissions.
# Defaults to the zero contributor address if not set.
WRFCOIN_CONTRIBUTOR_ADDRESS=0x0000000000000000000000000000000000000b02

# ------------------------------------------------------------------------------
# Public-Testnet Resource Limits
# ------------------------------------------------------------------------------

# Backend quotas are counted per client and route by the Redis-backed limiter.
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX_REQUESTS=60
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_REQUESTS=5

# Node and seed use identical mempool admission limits. A zero fee floor is
# intentional while faucet-funded earn traffic may submit zero-fee transactions.
WRFCOIN_MEMPOOL_MAX_SIZE_BYTES=10485760
WRFCOIN_MEMPOOL_MAX_TXS_PER_SENDER=64
WRFCOIN_MEMPOOL_MAX_AGE_SECS=3600
WRFCOIN_MEMPOOL_MIN_FEE_RATE=0

# ------------------------------------------------------------------------------
# P2P Peer Discovery (Required for a connected node)
# ------------------------------------------------------------------------------

# Comma-separated list of bootstrap peer multiaddresses.
# Format: /ip4/<IP>/tcp/9000/p2p/<PEER_ID>
# Leave empty to run an isolated node (useful for development only).
#
# Chain 888 public seed (= WRFCOIN_CUT_BOOTSTRAP in cut-pins.env; also in
# seeds.txt). join-testnet-sync-node.sh writes this for you.
# Optional tailnet fallback, only if the team gave you tailnet access:
#   BOOTSTRAP_PEERS=/ip4/<NODE_TAILNET_IP>/tcp/9000/p2p/12D3KooWMM7ukbQrn4BH2SjSNvyvAW2SaKUkHmDRng9KnifgYeWr
BOOTSTRAP_PEERS=/dns4/seed.wrfcoin.com/tcp/9000/p2p/12D3KooWMM7ukbQrn4BH2SjSNvyvAW2SaKUkHmDRng9KnifgYeWr

# N5 reference-node operators should also include the stable desktop peer in
# their private .env so reboot recovery is bidirectional instead of waiting for
# the desktop node to rediscover N5. Do not commit private tailnet multiaddrs.
#   BOOTSTRAP_PEERS=<published_seed_multiaddr>,/ip4/<DESKTOP_TAILNET_IP>/tcp/9000/p2p/<DESKTOP_PEER_ID>

# External multiaddr advertised by this node when running behind Docker/NAT.
# Required for producer, reference and serving nodes (WRFCOIN_SERVICE_ID set):
# supply an operator-verified reachable multiaddr; their startup fails closed
# when it is empty. A plain sync-only node (WRFCOIN_SYNC_ONLY=1) may leave it
# empty: it only dials out and needs no port forward.
#   WRFCOIN_P2P_EXTERNAL_ADDR=/ip4/<YOUR_PUBLIC_IP>/tcp/9000
WRFCOIN_P2P_EXTERNAL_ADDR=

# Optional relay peer multiaddresses for NAT traversal.
# Format: /ip4/<IP>/tcp/<PORT>/p2p/<PEER_ID>
WRFCOIN_P2P_RELAY_ADDRESSES=

# --- External reachability receipt (infra#840) --------------------------------
# Only needed when this host sits behind a router WITHOUT NAT hairpin/loopback
# reflection. There, boot-heal's self-dial of the PUBLIC advertised address
# cannot succeed even while outside peers connect normally, and boot-heal exits
# 1 on a stack that is actually fine.
#
# With these set, a WARN from the self-dial (public address did not answer) is
# resolved by a receipt from a probe OUTSIDE the NAT instead of failing the
# boot. Nothing else is relaxed: an unparsable, unset, known-vacant, or private
# address that fails its self-dial is still a hard failure, and a missing,
# stale, mismatched, or unsigned receipt is still a hard failure.
#
# One-time key ceremony, ON THE EXTERNAL PROBE HOST (never this node):
#   openssl genpkey -algorithm ed25519 -out probe-receipt.pem     # PRIVATE — stays there
#   openssl pkey -in probe-receipt.pem -pubout -out probe-receipt.pub
# Copy ONLY probe-receipt.pub to this node. The signature is asymmetric on
# purpose: this node holds the public key and gains no signing capability —
# it can verify receipts but can never mint one for itself.
#
# Produce a receipt from the external host with:
#   testnet/edge/emit-p2p-reachability-receipt.sh \
#     --multiaddr "$WRFCOIN_P2P_EXTERNAL_ADDR" --peer-id <PEER_ID> \
#     --key-file probe-receipt.pem --out receipt.env
# then copy it to WRFCOIN_P2P_RECEIPT_FILE on this host. Receipts EXPIRE, so
# this belongs on a timer, not in a runbook step someone ran last week.
#
# Leave empty to keep the strict self-dial-only behavior.
WRFCOIN_P2P_RECEIPT_FILE=
# The probe's ed25519 PUBLIC key (PEM). A private key here is refused outright.
WRFCOIN_P2P_RECEIPT_KEY_FILE=
# Maximum receipt age in seconds. Default 900; values above 3600 are refused.
WRFCOIN_P2P_RECEIPT_MAX_AGE_SECS=
# Identity binding is MANDATORY: a receipt for a different node or chain can
# never settle this node's guard. Set the peer id directly, or point
# WRFCOIN_P2P_PEER_ID_FILE at the node datadir's peer_id.txt; and set the
# chain's genesis hash. boot-heal refuses receipts when either is unresolvable.
WRFCOIN_P2P_PEER_ID=
WRFCOIN_P2P_PEER_ID_FILE=
WRFCOIN_GENESIS_HASH=

# ------------------------------------------------------------------------------
# Seed Node Operators Only (profile: seed)
# Regular operators should ignore this section.
# ------------------------------------------------------------------------------

# Bootstrap peers for seed-to-seed connectivity.
# Only set this if you are running a WRFCoin-operated seed node (--profile seed).
# Format: /ip4/<IP>/tcp/9001/p2p/<PEER_ID>
SEED_BOOTSTRAP_PEERS=

# External multiaddr advertised by the seed node when running behind Docker/NAT.
# Required when the seed profile is enabled. Supply an operator-verified
# reachable multiaddr; Compose fails closed when this value is empty.
#   WRFCOIN_SEED_P2P_EXTERNAL_ADDR=/ip4/<YOUR_VERIFIED_SEED_IP>/tcp/9001
WRFCOIN_SEED_P2P_EXTERNAL_ADDR=

# Storage encryption for node state at rest.
# Prefer WRFCOIN_STORAGE_ENCRYPTION_KEY in shared environments.
# For local-only development/testnet bring-up, ALLOW_UNENCRYPTED_STORAGE=true is accepted.
WRFCOIN_STORAGE_ENCRYPTION_KEY=
ALLOW_UNENCRYPTED_STORAGE=true

# ------------------------------------------------------------------------------
# Application Tuning (Optional — sensible defaults provided)
# ------------------------------------------------------------------------------

# Storage checkpoint interval in blocks.
# Default: 100
WRFCOIN_CHECKPOINT_INTERVAL=100

# Target number of gossipsub mesh peers per topic.
# Default: 4
WRFCOIN_GOSSIPSUB_MESH_N=4

# Minimum mesh peers before gossipsub grafts more peers.
# Default: 3
WRFCOIN_GOSSIPSUB_MESH_N_LOW=3

# Maximum mesh peers before gossipsub prunes peers.
# Default: 8
WRFCOIN_GOSSIPSUB_MESH_N_HIGH=8

# Minimum outbound-only mesh peers for eclipse resistance.
# Default: 2
WRFCOIN_GOSSIPSUB_MESH_OUTBOUND_MIN=2

# Flood new publishes beyond mesh peers on very small networks.
# Testnet default: true — peer_count is low; flood ensures blocks/txs reach all peers.
WRFCOIN_GOSSIPSUB_FLOOD_PUBLISH=true

# Close idle P2P connections after this many seconds.
# Default: 300
WRFCOIN_IDLE_CONNECTION_TIMEOUT_SECS=300

# Maximum peers allowed from the same /16 subnet; 0 disables the limit.
# Default: 2
WRFCOIN_MAX_PEERS_PER_SUBNET=2

# Maximum inline gossipsub payload size before CID indirection is required.
# Default: 65536
WRFCOIN_INLINE_DATA_MAX=65536

# Rust log level for the blockchain node.
# Options: error, warn, info, debug, trace
# Default: info
RUST_LOG=info

# Node.js log level for the backend.
# Options: error, warn, info, verbose, debug
# Default: info
LOG_LEVEL=info

# CORS allowed origin(s) for every backend service: comma-separated browser
# origins (scheme://host[:port], no path). REQUIRED wherever the backend
# services run, no default (infra#1056): check-env-completeness.sh and the
# release manifest refuse an empty, loopback, or wildcard value. The testnet
# browser origin is the Tailscale Funnel host (testnet/edge/FUNNEL_PREP-657.md);
# add https://<WRFCOIN_PUBLIC_DOMAIN> if the public 443 edge is also enabled.
CORS_ORIGIN=https://wrfcoin-testnet.taila1c049.ts.net

# --- Advisory reference-shadow scoring (infra#972) --------------------------
# OFF. Turn on ONLY with docker-compose.reference-shadow.yml plus
# `--profile oracle-reference` (see that file). It is advisory only: zero reward
# effect, and it does not touch consensus. The scorer is not at consensus parity
# yet (oracle-reference#9, backend#1169).
REFERENCE_SHADOW=0
# ORACLE_REFERENCE_URL=http://oracle-reference:8010
# ORACLE_REFERENCE_TIMEOUT_MS=5000

# --- Achievement-payout reconciler (infra#973) -------------------------------
# OFF. When true, backend re-POSTs pending achievement claims to core4
# POST /rewards/payout (on-chain payout; dedup'd by claim_id). Set true, or
# prefer docker-compose.payout-reconciler.yml, ONLY when the running core4 image
# includes core4#2081 (5ff889926). See UPGRADE_RUNBOOK.md.
REWARD_PAYOUT_RECONCILE_ENABLED=false
# REWARD_PAYOUT_RECONCILE_INTERVAL_MS=60000

# Grafana admin username (default: admin)
GRAFANA_ADMIN_USER=admin

# V8 heap limit for the main backend (1 GB container).
# Microservices (512 MB containers) use a proportionally smaller default (384 MB).
# Tune if you change deploy.resources.limits.memory in docker-compose.
NODE_OPTIONS=--max-old-space-size=768 --max-semi-space-size=32

# PostgreSQL connection-pool size per Node.js service (default 8).
# Connection budget: 5 pools x 8 = 40, plus Rust node (~10), plus headroom.
# Total connections across all services must stay below max_connections (200).
DB_POOL_SIZE=8

# ERC-4337 paymaster chain ID for gas sponsorship signature verification.
# Must match WRFCOIN_CHAIN_ID. Default: 777 (WRFCoin testnet).
PAYMASTER_CHAIN_ID=${WRFCOIN_CHAIN_ID:-777}

# Desktop peer compatibility. The desktop overlay passes this through to keep
# local empty-liveness validation aligned with N5 during testnet bring-up.
WRFCOIN_MIN_WORK_FACTOR=0

# ------------------------------------------------------------------------------
# Backend Microservices (shared across all Node.js services)
# ------------------------------------------------------------------------------

# Core4 blockchain node API URL (used by backend to query chain state).
# Inside Docker this resolves via the compose network; outside Docker use localhost:8556.
CORE4_API_URL=http://wrfcoin-node:8556

# Governance vote signing domain (backend#1329). Unset = governance vote
# signature verification fails closed (503). Public constants for testnet:
# chain id 777, network testnet, signing version 1.
# Signing version: 1 on chain 777 until the signing-v2 schedule extension;
# must match the chain.
# WRFCOIN_GOVERNANCE_CHAIN_ID=777
# WRFCOIN_GOVERNANCE_NETWORK_ID=testnet
# WRFCOIN_GOVERNANCE_SIGNING_VERSION=1

# Chain-station sync (backend#1288). Off unless STATION_CHAIN_SYNC_ENABLED=true.
# It is REQUIRED for phone stations: it is the only thing that marks a registered
# phone `on_chain`, so with it off every invitee stays "awaiting activation".
# LABELS is a JSON OBJECT keyed by station id, e.g. {"station-id":{"name":"..."}}
# (used only for labelled non-phone stations); `{}` is the valid empty value and is
# what a phone-only deployment wants (the sync starts with an empty map since
# backend#1339). It is NOT a comma-separated list. LABELS wins over LABELS_FILE, a
# path inside the container to the same JSON. INTERVAL_MS is the poll interval in
# milliseconds (default 600000, minimum 60000).
# STATION_CHAIN_SYNC_ENABLED=false
# STATION_CHAIN_SYNC_LABELS={}
# STATION_CHAIN_SYNC_LABELS_FILE=
# STATION_CHAIN_SYNC_INTERVAL_MS=

# Weather-submit authentication (backend#932). Unset or `off` (the default) accepts and
# warns on anonymous submits; `enforce` requires the station's submit token or the platform
# contributor token. Switching to enforce is an owner decision after every live collector
# carries a token. wrfcoin-backend passes this variable (infra compose, explicit list).
# WEATHER_SUBMIT_AUTH_MODE=off

# Mobile explorer summary (backend#1387): the faucet's PUBLIC address, read for
# faucetFunded. Unset is safe (faucetFunded reports null). Set on the host only.
# EXPLORER_FAUCET_ADDRESS=

# Height at which the backend's advisory reference tiering applies the gross-outlier
# guard (backend#1266). Empty = unscheduled. Must mirror the chain's governed
# schedule (core4#3277): update it on every re-schedule. Scoring is advisory only.
# REFERENCE_GROSS_GUARD_ACTIVATION_HEIGHT=

# Backend admin operation config (backend#1329). The admin routes send ONLY these
# server-side values and ignore the request body. Unset, empty or invalid = that
# route answers 503 CORE4_ADMIN_CONFIG_UNAVAILABLE (no live default). Addresses are
# 0x + 40 hex; the *_CONFIG values are single-line JSON objects (in a .env file write
# a literal $ as $$, and quote the whole value). All values below are PLACEHOLDERS.
# WRFCOIN_GOVERNANCE_PROPOSER_ADDRESS=0x0000000000000000000000000000000000000000
# WRFCOIN_ADMIN_GOVERNANCE_PROPOSAL_CONFIG='{"proposal_id":"example-id","parameter":"example_parameter","value":"example"}'
# WRFCOIN_MINING_REWARD_ADDRESS=0x0000000000000000000000000000000000000000
# WRFCOIN_ADMIN_NFT_MINT_CONFIG='{"id":"example-nft","owner":"0x0000000000000000000000000000000000000000"}'
# WRFCOIN_ADMIN_NFT_TRANSFER_CONFIG='{"id":"example-nft","to":"0x0000000000000000000000000000000000000000"}'
# SECRET-CLASS: WRFCOIN_ADMIN_STEALTH_CONFIG holds a spend key and a view key
# ({"spend_key":"<64 hex>","view_key":"<64 hex>"}). Set it only in the host .env,
# never commit a real value, never paste it into an issue or log.
# WRFCOIN_ADMIN_STEALTH_CONFIG=

# Console logging — ensures docker compose logs captures all backend output.
# Set to "true" so that logs are written to stdout/stderr (visible via
# docker compose logs) instead of file transports that are wasteful in
# read-only containers.
ENABLE_CONSOLE_LOGS=true
DISABLE_FILE_LOG_TRANSPORTS=true

# ------------------------------------------------------------------------------
# Frontend Dashboard
# ------------------------------------------------------------------------------

# Backend API URL injected at React build time (Vite build arg).
# Leave empty — frontend uses relative URLs (/api/...) and nginx proxies to backend.
# Only set for direct-to-backend development bypassing nginx.
VITE_API_URL=

# ed25519 wallet login/transfer identity baked into the frontend bundle
# (frontend#346). Must match the backend's wallet-auth chain ID (777) and
# network (testnet); the web wallet refuses to sign a login otherwise. The
# wallet-auth origin (VITE_WALLET_AUTH_ORIGIN, required: the wallet has no
# page-origin fallback) is passed automatically from WRFCOIN_WALLET_AUTH_ORIGIN
# / WRFCOIN_FUNNEL_ORIGIN (see docker-compose.override.yml). With the direct
# public edge (docker-compose.edge.yml, which pins the backend to
# https://$WRFCOIN_PUBLIC_DOMAIN) set WRFCOIN_WALLET_AUTH_ORIGIN to that same
# https://<public domain> so the frontend build bakes in the matching origin.
# VITE_WRFCOIN_CHAIN_ID=777
# VITE_WRFCOIN_NETWORK_ID=testnet

# Internal-surface switches (infra#974, frontend#348/#381). NON_RELEASE when set:
# they expose internal studio, demo and operator-preview routes. Leave them
# unset/empty on every public or testnet host. They take effect only in a
# staging build (WRFCOIN_FRONTEND_BUILD_VARIANT=staging); with the default
# `public` variant, Dockerfile.frontend refuses to build if any VITE_ENABLE_* is
# non-empty, and render-release-manifest.sh never accepts a staging image.
# Any non-empty value is refused, including `false`: frontend's own .env.example
# sets VITE_ENABLE_CONTRACT_SURFACES=false, so a frontend .env copied from it
# fails the public build until that value is emptied or the line deleted.
# WRFCOIN_FRONTEND_BUILD_VARIANT=public
# VITE_ENABLE_FULL_STUDIO=
# VITE_ENABLE_DEMO_SURFACES=
# VITE_ENABLE_OPERATOR_PREVIEW=
# VITE_ENABLE_CONTRACT_SURFACES=
# Staging values must be empty or exactly true; frontend .env files cannot
# supply non-empty switches. Set these in the Compose/build shell or the
# deployment env file (outside the frontend source tree), then rebuild.

# Stage 1.5 public read-only stage (infra#983, frontend#349/#360). Both default
# OFF; turning either on is the owner's call in a deploy window.
# VITE_PUBLIC_READONLY_PATHS: frontend build arg for /explore, /explorer, /map,
#   /search and station detail. Empty (off) or exactly `true`; any other value
#   is refused by Dockerfile.frontend. Allowed in the public variant.
# PUBLIC_READONLY_API: edge toggle for the station reads those pages make
#   (GET /api/weather/stations, /api/stations/<id>/{observations,quality,
#   submissions}). The edge admits them only when this is exactly `on`. Keep it
#   off until the backend's anonymous 0.01-degree coordinate projection
#   (backend#1222) is deployed: the station list serializes exact home
#   coordinates before that.
# VITE_PUBLIC_READONLY_PATHS=
# PUBLIC_READONLY_API=off

# Onboarding faucet claim step (frontend#437 W28, owner ruling 2026-10-02 #14).
# VITE_FAUCET_OPEN: frontend build arg. Empty (off, the default): /onboarding
#   says the faucet is not funded yet and lets the visitor continue. Exactly
#   `true`: the step offers the challenge and claim. Any other value is refused
#   by Dockerfile.frontend. Allowed in the public variant. Turn it on only in a
#   deploy window after the faucet is funded; the edge already admits
#   POST /api/onboarding/faucet/{challenge,claim}.
# VITE_FAUCET_OPEN=

# Web Send kill switch (frontend#552 S9, infra#1329).
# VITE_DISABLE_WALLET_SEND: frontend build arg. Empty (the default): web Send is
#   visible. Exactly `true`: Send is hidden. Web Send is ON for the public build
#   (owner ruling 2026-10-15), so the public variant REFUSES `true`; only a
#   staging build may hide Send. Any other value is refused. The guard prints
#   FRONTEND_DISABLE_WALLET_SEND=on|off in the build log either way.
# VITE_DISABLE_WALLET_SEND=

# Path to the frontend repo on the host (Docker build context).
FRONTEND_PATH=${WRFCOIN_ROOT:-${WRFCOIN_DEPLOY_ROOT:-/path/to/wrfcoin-deploy}}/frontend

# ------------------------------------------------------------------------------
# Build Context Root (Required for non-root operators — issue #281)
# ------------------------------------------------------------------------------

# Absolute path to the wrfcoin workspace root on the host.
# Defaults to WRFCOIN_DEPLOY_ROOT; replace the example root paths before use.
# Non-root operators must set this to their own checkout path:
#   WRFCOIN_ROOT=<deploy-root>
# This value is used as the Docker build context in docker-compose.override.yml.
WRFCOIN_ROOT=${WRFCOIN_DEPLOY_ROOT:-/path/to/wrfcoin-deploy}

# ------------------------------------------------------------------------------
# Weather Collection (docker compose --profile collector up)
# ------------------------------------------------------------------------------

# Ambient Weather API keys — get from https://ambientweather.net/account
# Required for the weather data collector service.
AMBIENT_WEATHER_APP_KEY=
AMBIENT_WEATHER_API_KEY=

# Path to the core4 repo on the host (for mounting weather collector script).
CORE4_PATH=${WRFCOIN_ROOT:-${WRFCOIN_DEPLOY_ROOT:-/path/to/wrfcoin-deploy}}/core4

# ------------------------------------------------------------------------------
# Optional Faucet UI (profile: seed)
# ------------------------------------------------------------------------------

# The faucet is opt-in. Leave blank unless you run the seed profile faucet.
#
# The faucet submits a transparent transfer via the node REST API
# (POST /transactions/submit). It needs a funded wallet AND a node API token
# mapped to a Contributor (or higher) role. FAUCET_API_TOKEN defaults to
# WRFCOIN_OPERATOR_TOKEN when unset (the operator token satisfies Contributor).
FAUCET_WALLET_PRIVKEY=
FAUCET_WALLET_ADDRESS=
# Optional: dedicated token for the faucet. Falls back to WRFCOIN_OPERATOR_TOKEN.
# This same token authenticates the backend onboarding proxy (#857 Option B):
# requests bearing it skip public captcha (the proxy enforces math-captcha +
# 24h address cooldown + IP limits) and rate-limit on the forwarded client IP.
FAUCET_API_TOKEN=
# Prometheus scraper token for the faucet's /metrics. It MUST equal the value in
# prometheus-bearer-token, or Prometheus's wrfcoin-faucet scrape gets 403
# (infra#1078). Leave it EMPTY: compose then passes WRFCOIN_READER_TOKEN, which is
# the value setup-env.sh writes into prometheus-bearer-token. Set it only if you
# also write the same value into that file. The faucet reads it at container
# creation, so a change needs a faucet recreate. (Inside the faucet, an empty
# value falls back to FAUCET_API_TOKEN.)
FAUCET_METRICS_TOKEN=
# Backend→faucet dispense URL for the onboarding proxy. The compose default
# (http://wrfcoin-faucet:8080/faucet/request) is correct for the seed stack.
# FAUCET_SERVICE_URL=http://wrfcoin-faucet:8080/faucet/request
# Whole-coin amount dispensed per claim (converted to base units, x10^8).
FAUCET_AMOUNT=10
# Leave false unless a trusted reverse proxy injects one fixed forwarding hop.
FAUCET_TRUST_PROXY=false
# Independent payout caps, in whole WRF, reset at UTC midnight.
FAUCET_WALLET_DAILY_CAP=10
# infra#1157: per-device daily cap (whole WRF); default one claim per device per UTC day.
FAUCET_DEVICE_DAILY_CAP=10
FAUCET_GLOBAL_DAILY_CAP=1000
# Refuse claims that would leave the faucet wallet below this whole-WRF floor.
FAUCET_WALLET_BALANCE_FLOOR=10
FAUCET_WALLET_BALANCE_PATH=/addresses/{address}
# REQUIRED when the faucet runs (COMPOSE_PROFILES includes faucet or seed):
# absolute bucket high-water mark in whole WRF (> 0, at most 8 decimals). No
# default on purpose: the faucet exits at startup without it, and
# check-env-completeness.sh reports it as an ERROR before `up` (infra#1121).
# FAUCET_REFILL_SOURCE (manual|emission|treasury) defaults to manual.
FAUCET_HIGH_WATER_MARK=
# Once FAUCET_WALLET_PRIVKEY is set, CAPTCHA_PROVIDER=off fails closed.
FAUCET_CAPTCHA_PROVIDER=hcaptcha
FAUCET_HCAPTCHA_SITEKEY=
FAUCET_HCAPTCHA_SECRET=
FAUCET_RECAPTCHA_SITEKEY=
FAUCET_RECAPTCHA_SECRET=
FAUCET_RECAPTCHA_MIN_SCORE=0.5
FAUCET_DISCORD_WEBHOOK_URL=
FAUCET_DISCORD_WEBHOOK_USERNAME=WRFCoin Faucet
FAUCET_DISCORD_WEBHOOK_AVATAR_URL=
DISCORD_INVITE_URL=https://discord.gg/wrfcoin-testnet
EXPLORER_URL=http://localhost:8081

# ------------------------------------------------------------------------------
# Optional RTL-SDR Weather Enrichment (profile: experimental)
# ------------------------------------------------------------------------------

SDR_POLL_INTERVAL=5
SDR_PROTOCOLS=acurite,oregon,fine_offset
SDR_FIXTURE_FILE=

# ------------------------------------------------------------------------------
# Node snapshot signer — PKCS#11 (required in release builds)
# See docs/operator/hsm-migration.md for SoftHSM2 and YubiKey setup.
# ------------------------------------------------------------------------------

# YubiKey mode (CT 101 rollout target):
WRFCOIN_HSM_MODE=yubikey
WRFCOIN_HSM_MODULE_PATH=/usr/lib/x86_64-linux-gnu/libykcs11.so
WRFCOIN_HSM_TOKEN_LABEL=YubiKey PIV #REPLACE
WRFCOIN_HSM_KEY_LABEL=Private key for Digital Signature
WRFCOIN_HSM_PUBKEY_LABEL=Public key for Digital Signature
WRFCOIN_HSM_PIN_ENV=WRFCOIN_HSM_PIN
# If any plaintext deploy helper PIN was used on this node, rotate the HSM PIN
# and signing material before launch; never commit the old value.
WRFCOIN_HSM_PIN=SET_PER_NODE_NEVER_COMMIT

# SoftHSM2 fallback (leave commented unless you are intentionally rolling back):
# WRFCOIN_HSM_MODE=softhsm
# WRFCOIN_HSM_MODULE_PATH=/usr/lib/softhsm/libsofthsm2.so
# WRFCOIN_HSM_TOKEN_LABEL=wrfcoin-validator
# WRFCOIN_HSM_KEY_LABEL=wrfcoin-signing-key
# WRFCOIN_HSM_PIN_ENV=WRFCOIN_HSM_PIN
# Required when using SoftHSM2 mode - no default is accepted (compose will refuse to start without it).
# Choose a strong value; rotate before any testnet exposure; never commit the real value.
# WRFCOIN_HSM_SO_PIN=SET_TO_STRONG_VALUE_NEVER_COMMIT

# ------------------------------------------------------------------------------
# Oracle attester (opt-in overlays; one distinct identity per quorum host)
# See ORACLE_ATTESTER_CUTOVER.md. Never commit real PINs or tokens.
# ------------------------------------------------------------------------------

# Both existing-YubiKey and SoftHSM paths use these role-specific names.
WRFCOIN_ATTESTER_HSM_MODULE_PATH=
WRFCOIN_ATTESTER_HSM_TOKEN_LABEL=
WRFCOIN_ATTESTER_HSM_KEY_LABEL=
WRFCOIN_ATTESTER_HSM_PUBKEY_LABEL=
WRFCOIN_ATTESTER_HSM_PIN=

# SoftHSM-only. Provision defaults off and must be enabled only during the
# attended owner ceremony; return it to 0 before starting the daemon.
WRFCOIN_ATTESTER_HSM_SO_PIN=
WRFCOIN_ATTESTER_HSM_PROVISION=0

# Public custody inventory. These are public keys, but every value must be
# sourced from the ceremony record and must differ from the oracle key.
WRFCOIN_ATTESTER_FORBID_GOVERNANCE_PUBKEY=
WRFCOIN_ATTESTER_FORBID_SNAPSHOT_PUBKEY=
WRFCOIN_ATTESTER_FORBID_PRODUCER_PUBKEY=

# Required per deployment: an NWS station id such as KDLH, or the explicit
# PHYSICS_ONLY sentinel for the attester's loud capped no-reference mode.
WRFCOIN_ATTESTER_NWS_STATION=
WRFCOIN_ATTESTER_POLL_SECS=5
WRFCOIN_ATTESTER_MAX_AGE_SECS=3600
WRFCOIN_ATTESTER_MAX_FUTURE_SKEW_SECS=300
WRFCOIN_ATTESTER_REFERENCE_MAX_PAIR_SECS=1800
# Reference-station selection (core4#3240). Leave BOTH unset: the attester stays in
# `fixed` mode (every commit vs WRFCOIN_ATTESTER_NWS_STATION) and ignores the cap.
# Owner ruling 2026-10-05: the shadow run's cap is the station registry's P95
# nearest-reference distance (about 11-12 km on current data), NOT the old unsourced
# 3.4 km. Derive it at deploy time from a registry listing; the tool prints only
# counts and km, never coordinates or ids:
#   python3 scripts/registry-reference-distance-p95.py --input <registry-listing.json>
# `shadow` submits the fixed verdict and only logs the per-station one; flipping to
# `per_station` changes rewards and stays owner-gated. There is no default cap.
# WRFCOIN_ATTESTER_REFERENCE_MODE=shadow
# WRFCOIN_ATTESTER_MAX_REFERENCE_KM=<P95 from the tool, in km>
WRFCOIN_ATTESTER_ONCE=0

# ------------------------------------------------------------------------------
# Optional: HSM / Vault (backend microservices — leave empty for testnet)
# ------------------------------------------------------------------------------

# Hardware Security Module endpoint for key operations.
HSM_ENDPOINT=
HSM_KEY_ID=

# HashiCorp Vault endpoint for secret management.
VAULT_ENDPOINT=

# ==============================================================================
# Public-internet edge (infra#636) — ONLY set these when deliberately going
# public via docker-compose.edge.yml. Leave UNSET for tailnet-only operation.
# See testnet/edge/README.md for the full cutover procedure.
# ==============================================================================

# Apex domain that resolves (publicly) to this host. The edge also serves
# explorer.<domain>, faucet.<domain>, api.<domain> — all four need DNS records.
# WRFCOIN_PUBLIC_DOMAIN=testnet.example.org

# Email for Let's Encrypt certificate issuance + expiry notices.
# ACME_EMAIL=ops@example.org

# Compose project network name the edge joins (only needed if you run the edge
# as a SEPARATE compose project rather than as an overlay in one command).
# TESTNET_NETWORK_NAME=testnet_wrfcoin-testnet

# --- Funnel-facing edge (infra#657, docker-compose.funnel-edge.yml) ----------
# The exact browser origin Tailscale Funnel serves; becomes the backend
# CORS_ORIGIN while the funnel-edge overlay is active. It also becomes the
# wallet-login (SIWE) origin automatically: the backend's
# WRFCOIN_WALLET_AUTH_ORIGIN defaults to WRFCOIN_FUNNEL_ORIGIN, so a funnel
# deploy binds wallet challenges to the real public domain with no extra step.
# WRFCOIN_FUNNEL_ORIGIN=https://wrfcoin-testnet.taila1c049.ts.net
#
# Override only if wallet login must use a different origin than CORS/Funnel.
# Must be exactly one HTTPS origin (no comma list, no path) under production, or
# the API gateway fails closed at boot (backend#1052).
# WRFCOIN_WALLET_AUTH_ORIGIN=https://wrfcoin-testnet.taila1c049.ts.net

# Node-pay snapshot receipts: the bond's service_alias, e.g. node-ws.
# Set per node before the next planned restart; empty is not a bonded identity.
WRFCOIN_SERVICE_ID=
