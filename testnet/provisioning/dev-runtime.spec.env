# =============================================================================
# Dev-runtime spec (infra#595) — NVMe placement + the dev service subset
# =============================================================================
# Runs the WRFCoin stack on the #594 workload host (CT 103) so the desktop stops
# carrying it. Two things decide whether that is worth doing at all, and both
# are checkable: WHERE the bytes land, and WHICH services start.
#
# The service inventory is NOT restated here. testnet/edge/route-ledger.yml
# (#598) is the authority on all 32 compose services; this file names only the
# subset the dev runtime starts and the reason for each exclusion. If a service
# is added to compose, the ledger gate (#598) forces an exposure decision and
# DEV_RUNTIME_UNSELECTED_OK below forces a dev-runtime decision — neither can
# be answered by silence.

# --- storage placement: the entire point of #595 ----------------------------
# MEASURED on the host 2026-07-31, and it inverts the obvious guess:
#
#   nvme0n1  ROTA=0  3.6T  WD_BLACK SN850X   <-- the ONLY NVMe; backs local-lvm
#   sda..sde ROTA=1  9.1T  TOSHIBA HDWG71A   <-- tank, RAIDZ1, SPINNING
#
# `tank` is a 5-disk RAIDZ1 of 7200rpm HDDs. CT101 deliberately puts the
# testnet Docker data-root there (/mnt/tank-docker/docker-data) because the
# chain wants capacity and redundancy. A DEV runtime wants the opposite: cargo
# and npm builds are random-write-heavy, which is RAIDZ1's worst case. Placing
# the dev checkout or Docker data-root on tank would satisfy "on the N5" while
# defeating "fast NVMe path" — the acceptance criterion would read green and
# the build would be slower than the desktop it replaced.
DEV_RUNTIME_EXPECTED_BACKING=nvme
DEV_RUNTIME_CHECKOUT_PATH=/opt/wrfcoin-dev
DEV_RUNTIME_DOCKER_ROOT=/var/lib/docker

# --- volumes: named only, never bind mounts ---------------------------------
# CT 103 is unprivileged (#594 spec). Bind-mounting a host path into an
# unprivileged LXC lands on the uid-shift problem; named Docker volumes do not.
# This is the same constraint the testnet stack already operates under.
DEV_RUNTIME_REQUIRE_NAMED_VOLUMES=1

# --- the dev subset, by ledger name -----------------------------------------
# Chosen as "what a developer needs to exercise the chain and the API locally".
DEV_RUNTIME_SERVICES="postgres redis db-migrate wrfcoin-node wrfcoin-backend wrfcoin-frontend"

# Services deliberately NOT started by the dev runtime, with the reason. The
# verifier requires every ledger service to appear in exactly one of the two
# lists, so a new service cannot be silently absent from dev.
#   wrfcoin-seed              second chain node; dev runs one
#   wrfcoin-faucet            dispenses funds; #604/#658 hazard surface, not dev
#   wrfcoin-explorer          optional UI, adds build time
#   wrfcoin-governance        "
#   wrfcoin-iot               "
#   wrfcoin-weather-earnings  "
#   wrfcoin-cross-chain       "
#   wrfcoin-compute           "
#   wrfcoin-ml                "
#   wrfcoin-storage           "
#   wrfcoin-node-discovery    "
#   weather-collector         pulls live provider data; would submit as a real contributor
#   sdr-ingest                needs SDR hardware
#   oracle-reference          needs GRIB fetch + 10GB cache
#   softhsm-init              signing is off in dev; node runs unsigned
#   softhsm-seed-init         "
#   prometheus                monitoring stack: 7 services of pure overhead for dev
#   grafana                   "
#   alertmanager              "
#   node-exporter             "
#   cadvisor                  "
#   postgres-exporter         "
#   blackbox-exporter         "
#   loki                      "
#   promtail                  "
DEV_RUNTIME_UNSELECTED_OK="wrfcoin-seed wrfcoin-faucet wrfcoin-explorer wrfcoin-governance wrfcoin-iot wrfcoin-weather-earnings wrfcoin-cross-chain wrfcoin-compute wrfcoin-ml wrfcoin-storage wrfcoin-node-discovery weather-collector sdr-ingest oracle-reference softhsm-init softhsm-seed-init prometheus grafana alertmanager node-exporter cadvisor postgres-exporter blackbox-exporter loki promtail"
