# =============================================================================
# Workload host spec (infra#594) — the reproducibility contract
# =============================================================================
# The N5 is a hand-built artefact today: every hazard this sprint traced back to
# "it was set up once, by hand, and nothing states what it should be" (#436 DHCP
# drift, #673's vacant advertisement, the retired operator guide). This file is
# the statement. scripts/tests/verify-workload-host.sh holds a real container to
# it, so drift is a failing check rather than a discovery during an incident.
#
# This spec describes the NEW workload container (#594) — the home for the
# internal gateway (#598), remote-dev (#596), and anything else that must not
# share a blast radius with the live testnet node.
#
# It deliberately does NOT describe CT101 (testnet) or CT102 (runner): those
# exist, are load-bearing, and re-provisioning them is not what #594 asks for.
# Their specs can be added later once this one has been exercised.

# --- identity ---------------------------------------------------------------
WORKLOAD_CTID=103
WORKLOAD_HOSTNAME=wrfcoin-workload

# --- isolation --------------------------------------------------------------
# Unprivileged is NOT optional. CT101 is unprivileged; CT100 (the stopped
# wrfcoin-docker leftover) is PRIVILEGED, which means root inside it is root on
# the host. A workload host that runs a public-adjacent gateway must not be the
# weaker of the two. `nesting=1` is what lets Docker run inside an unprivileged
# LXC; keyctl=1 is required by some container runtimes and matches CT101.
WORKLOAD_UNPRIVILEGED=1
WORKLOAD_FEATURES=nesting=1,keyctl=1

# --- resource ceiling (acceptance item 3: "resource allocation documented") ---
# Sized so it CANNOT starve CT101 (8 cores / 32 GB, the live chain) even when
# fully loaded. Host has 12C/24T and 96 GB; CT102 already holds 6C/12 GB.
WORKLOAD_CORES=4
WORKLOAD_MEMORY_MB=16384
WORKLOAD_SWAP_MB=2048
WORKLOAD_ROOTFS_GB=64
WORKLOAD_ROOTFS_STORAGE=local-lvm

# --- network ----------------------------------------------------------------
# Static, not DHCP. #436/#673 are the same disease: an address that moves while
# documents and forwards keep pointing at where it used to be. The workload host
# starts static so it never joins that class.
WORKLOAD_IPV4="<WORKLOAD_HOST_IP>/24"
WORKLOAD_GATEWAY="<GATEWAY_IP>"
WORKLOAD_BRIDGE=vmbr0

# --- mesh -------------------------------------------------------------------
# Tailscale identity is tagged, never a personal-device login: tags survive key
# rotation and are revocable without touching a human account. The tag is
# distinct from tag:wrfcoin-joiner (#587) and tag:wrfcoin-viewer (#599) so its
# ACL can be scoped independently.
WORKLOAD_TS_TAG=tag:wrfcoin-workload
WORKLOAD_TS_HOSTNAME=wrfcoin-workload

# --- blast radius (acceptance item 2: "snapshot/rollback verified") ----------
# A snapshot taken at provisioning time, before anything is deployed onto it,
# is what makes rollback a capability rather than an intention. The verifier
# FAILS when it is absent — see the finding on #594: CT101 has no snapshots at
# all today, so the rollback half of this issue's acceptance criteria has never
# been exercised on the live node.
WORKLOAD_BASE_SNAPSHOT=provisioned-base
