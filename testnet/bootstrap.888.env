# Public bootstrap inputs only, interpolated from the reviewed cut environment.
# Required even on snapshot joins: never fall back to compiled chain-777 pins.
WRFCOIN_GENESIS_HASH=${WRFCOIN_GENESIS_HASH:?set WRFCOIN_GENESIS_HASH from the reviewed cut pins}
WRFCOIN_GENESIS_ACTIVATION_SCHEDULE=${WRFCOIN_GENESIS_ACTIVATION_SCHEDULE:?set the reviewed WRFCOIN_GENESIS_ACTIVATION_SCHEDULE}
WRFCOIN_GENESIS_PRODUCER_SET=${WRFCOIN_GENESIS_PRODUCER_SET:?set the reviewed WRFCOIN_GENESIS_PRODUCER_SET}
# The rest of the genesis declarations docker-compose.genesis.yml gave the
# cutter: a joiner validates the chain against the same inputs it was cut with.
WRFCOIN_GENESIS_ORACLE_SET=${WRFCOIN_GENESIS_ORACLE_SET:?set the reviewed WRFCOIN_GENESIS_ORACLE_SET}
WRFCOIN_GENESIS_SCHEDULE_GOVERNANCE_KEYS=${WRFCOIN_GENESIS_SCHEDULE_GOVERNANCE_KEYS:?set the reviewed WRFCOIN_GENESIS_SCHEDULE_GOVERNANCE_KEYS}
WRFCOIN_GENESIS_FAUCET_ADDRESS=${WRFCOIN_GENESIS_FAUCET_ADDRESS:?set WRFCOIN_GENESIS_FAUCET_ADDRESS from the reviewed cut pins}
WRFCOIN_GENESIS_FAUCET_ALLOCATION_BASE_UNITS=${WRFCOIN_GENESIS_FAUCET_ALLOCATION_BASE_UNITS:?set the reviewed WRFCOIN_GENESIS_FAUCET_ALLOCATION_BASE_UNITS}
WRFCOIN_GENESIS_FLAT_REWARD_BASE_UNITS=${WRFCOIN_GENESIS_FLAT_REWARD_BASE_UNITS:?set the reviewed WRFCOIN_GENESIS_FLAT_REWARD_BASE_UNITS}
WRFCOIN_GENESIS_FLAT_REWARD_SECONDS=${WRFCOIN_GENESIS_FLAT_REWARD_SECONDS:?set the reviewed WRFCOIN_GENESIS_FLAT_REWARD_SECONDS}
WRFCOIN_GENESIS_NODE_SHARE_EPOCH_BLOCKS=${WRFCOIN_GENESIS_NODE_SHARE_EPOCH_BLOCKS:?set the reviewed WRFCOIN_GENESIS_NODE_SHARE_EPOCH_BLOCKS}
WRFCOIN_GENESIS_NODE_SHARE_CHALLENGE_BLOCKS=${WRFCOIN_GENESIS_NODE_SHARE_CHALLENGE_BLOCKS:?set the reviewed WRFCOIN_GENESIS_NODE_SHARE_CHALLENGE_BLOCKS}
WRFCOIN_SIGNING_PROTOCOL_VERSION=${WRFCOIN_SIGNING_PROTOCOL_VERSION:?set the reviewed WRFCOIN_SIGNING_PROTOCOL_VERSION}
