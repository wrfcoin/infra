# Public bootstrap inputs only, interpolated from the reviewed cut environment.
# Required even on snapshot joins: never fall back to compiled chain-777 pins.
WRFCOIN_GENESIS_HASH=${WRFCOIN_GENESIS_HASH:?set WRFCOIN_GENESIS_HASH from the reviewed cut pins}
WRFCOIN_GENESIS_ACTIVATION_SCHEDULE=${WRFCOIN_GENESIS_ACTIVATION_SCHEDULE:?set the reviewed WRFCOIN_GENESIS_ACTIVATION_SCHEDULE}
WRFCOIN_GENESIS_PRODUCER_SET=${WRFCOIN_GENESIS_PRODUCER_SET:?set the reviewed WRFCOIN_GENESIS_PRODUCER_SET}
