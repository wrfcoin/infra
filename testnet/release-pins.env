# Reviewed source heads for the next reproducible testnet release candidate.
# No secrets belong here. Update only from `git rev-parse`/the repository API,
# then run testnet/scripts/render-release-manifest.sh before building.
# Moving the backend pin across a new drizzle migration also moves
# WRFCOIN_EXPECTED_DB_MIGRATION in docker-compose.testnet.yml (db-migrate refuses otherwise).
WRFCOIN_RC_CORE4_COMMIT=de9d0d268e1a914109444c1d49b2dcfffe896d80
WRFCOIN_RC_BACKEND_COMMIT=dec7b920f941b681c97fb29db3417c98fd699bae
WRFCOIN_RC_FRONTEND_COMMIT=a5c36907ac17d1de6cceccf5db341475a73c6dbe
# Storage group (infra#1268, `--storage`). Both keys are required together; the digest is the
# `ipfs/kubo:v0.24.0` multi-arch index digest (registry HEAD Docker-Content-Digest, 2026-10-05).
WRFCOIN_RC_IPFS_KUBO_DIGEST=sha256:e3de33bd746b0a9317da32e76f2c493a318493af895f5f40d2ec2237ee04bf71
WRFCOIN_RC_STORAGE_PROVIDERS_COMMIT=c01998e95cf548c814b89c73332c3e3d3891ccc3
WRFCOIN_RC_MIN_PUBLIC_BUILD_DATE=2026-10-02
