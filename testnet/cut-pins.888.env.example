# PUBLIC IDENTITY TEMPLATE ONLY. Owner fills after the reviewed rehearsal/cut.
# Do not replace cut-pins.env until the cut; placeholders deliberately fail validation.
WRFCOIN_CHAIN_ID=888
WRFCOIN_CUT_CHAIN_ID=888
WRFCOIN_CUT_NETWORK_ID=testnet
WRFCOIN_CUT_CORE4_COMMIT="<REVIEWED_CORE4_COMMIT>"
WRFCOIN_CUT_GENESIS_HASH="<GENESIS_HASH_AFTER_CUT>"
WRFCOIN_GENESIS_HASH="${WRFCOIN_CUT_GENESIS_HASH}"
WRFCOIN_CUT_BOOTSTRAP=/dns4/seed.wrfcoin.com/tcp/9000
WRFCOIN_CUT_GENESIS_FAUCET_ADDRESS="<GENESIS_FAUCET_ADDRESS>"
WRFCOIN_CUT_SNAPSHOT_TRUSTED_SIGNERS=

# Genesis declarations for docker-compose.genesis.yml; eight named gates at block 2; genesis faucet address supplies faucet binding.
# Source this public template with export enabled after filling placeholders.
WRFCOIN_SIGNING_PROTOCOL_VERSION=1
WRFCOIN_GENESIS_ACTIVATION_SCHEDULE=0:v1,2:schedule_extension,2:reward_gross_outlier_guard,2:weather_skew_block_time_allowance,2:station_active_reward_gate,2:station_owner_actions,2:station_owner_consent,2:station_registration_nonce,2:node_share_settlement
WRFCOIN_GENESIS_FLAT_REWARD_SECONDS=600
WRFCOIN_GENESIS_FLAT_REWARD_BASE_UNITS=2222222222
WRFCOIN_GENESIS_FAUCET_ALLOCATION_BASE_UNITS=10000000000000
WRFCOIN_GENESIS_SCHEDULE_GOVERNANCE_KEYS=e7bec166ad446314d26fb7526bfa8cec1b363b438440262fb001f7b04b20bf00
WRFCOIN_GENESIS_NODE_SHARE_EPOCH_BLOCKS=512
WRFCOIN_GENESIS_NODE_SHARE_CHALLENGE_BLOCKS=512
WRFCOIN_GENESIS_PRODUCER_SET="<REVIEWED_PRODUCER_SET>"
WRFCOIN_GENESIS_ORACLE_SET="<REVIEWED_ORACLE_SET>"
WRFCOIN_GENESIS_FAUCET_ADDRESS="<GENESIS_FAUCET_ADDRESS>"
