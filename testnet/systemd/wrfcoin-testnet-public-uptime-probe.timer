[Unit]
Description=Run WRFCoin testnet public availability probe periodically
Requires=wrfcoin-testnet-public-uptime-probe.service

[Timer]
Unit=wrfcoin-testnet-public-uptime-probe.service
OnBootSec=2m
OnUnitInactiveSec=10m
AccuracySec=1m
RandomizedDelaySec=90s
Persistent=true

[Install]
WantedBy=timers.target
