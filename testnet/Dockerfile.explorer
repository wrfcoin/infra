# WRFCoin Testnet Block Explorer
# node:20-alpine
FROM node:25-alpine@sha256:bdf2cca6fe3dabd014ea60163eca3f0f7015fbd5c7ee1b0e9ccb4ced6eb02ef4

WORKDIR /app

RUN apk add --no-cache curl

# Create non-root user
RUN addgroup -g 1001 -S wrfcoin && \
    adduser -S wrfcoin -u 1001

# Install only production deps
COPY infra/testnet/explorer/package*.json ./
RUN npm install --omit=dev && chown -R wrfcoin:wrfcoin /app

# Copy app code
COPY --chown=wrfcoin:wrfcoin infra/testnet/explorer/server.js ./
COPY --chown=wrfcoin:wrfcoin infra/testnet/explorer/public/ ./public/

USER wrfcoin

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8081/health || exit 1

CMD ["node", "server.js"]
