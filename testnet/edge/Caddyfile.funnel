# =============================================================================
# WRFCoin public edge (infra#657): no public bind, behind the Cloudflare Tunnel
# =============================================================================
# Why this file exists: the deployed frontend nginx proxies /api/, /ws and
# /api/ws wholesale to the backend, so `tailscale funnel http://127.0.0.1:5000`
# would publish the ENTIRE backend API and nullify the #658 boundary that
# #679 built. The funnel must therefore target THIS edge, which enforces the
# same exact onboarding allowlist as the direct 443 edge:
#
#   internet → Tailscale Funnel (TLS, *.ts.net) → 127.0.0.1:8444 (this Caddy)
#            → allowlisted API → backend:4001 | everything else → frontend:5000
#
# Since 2026-10-31 wrfcoin.com reaches the same listener a second way, which is
# now the main one:
#
#   internet → Cloudflare → wrfcoin-cloudflared (10.251.0.13) → this Caddy :8444
#
# No ACME, no public bind: TLS terminates at the funnel; the compose overlay
# (docker-compose.funnel-edge.yml) binds the host port on 127.0.0.1 only, so
# without an active funnel this edge is unreachable from anywhere but CT101.
#
# The allowlist lives in public_onboarding.caddy, shared with Caddyfile —
# change the boundary there, never here.
#
# Requires the caddy-ratelimit build (Dockerfile.caddy), same image as the edge.
# =============================================================================
{
	auto_https off
	order rate_limit before basic_auth
	servers {
		# USE THE VISITOR'S ADDRESS BEHIND THE TUNNEL: trust exactly one peer, the
		# wrfcoin-cloudflared container, and read exactly one header from it.
		#
		# Cloudflare sets Cf-Connecting-IP to the address that connected to it and
		# overwrites any value the visitor sent, so it holds one address nobody
		# outside Cloudflare can choose. X-Forwarded-For is not read here: Cloudflare
		# keeps whatever the visitor sent and appends to it.
		#
		# The peer is an exact /32 on the pinned ingress network (see "Tunnel address"
		# in README.md). Every other peer is untrusted, so its {client_ip} is its own
		# socket address and these headers are ignored. That includes the
		# 10.251.0.1 gateway, the source of everything arriving through the
		# 127.0.0.1:8444 port. Tailscale Funnel traffic comes that way, and tailscaled
		# overwrites X-Forwarded-For but not Cf-Connecting-IP, so trusting the gateway
		# with this header would let those clients choose their own address. Funnel
		# visitors therefore share one rate-limit key, which is the safe direction:
		# the backend treats the gateway as a shared proxy and never bans it.
		#
		# If the tunnel container is not at this address, or the header is missing or
		# malformed, {client_ip} falls back to the socket peer: all visitors share one
		# key, never a visitor-chosen one.
		#
		# Never widen this to private_ranges or a subnet: any other container on the
		# network could then set the header. If the tunnel's address changes, change
		# it here, in the backend's TRUSTED_PROXIES and in the README together
		# (scripts/tests/test-edge-onboarding-block.sh checks that they agree).
		client_ip_headers Cf-Connecting-IP
		trusted_proxies static 10.251.0.13/32
		trusted_proxies_strict
	}
}

import public_onboarding.caddy
import downloads.caddy

:8444 {
	# Access log (infra#884), deliberately narrow.
	#
	# `request>headers` and `resp_headers` are DELETED from the record. Caddy's
	# default access log emits every request header (Authorization and Cookie
	# redacted, but User-Agent, Accept and the rest in full), which is more than
	# this edge needs. What remains is the standard access skeleton (method, uri,
	# status, duration, the peer address, and client_ip, which behind the tunnel
	# is the visitor's address) plus the one named field below: X-Forwarded-For
	# as it arrived, captured before the rewrite further down.
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>headers delete
				resp_headers delete
			}
		}
	}
	vars inbound_xff {http.request.header.X-Forwarded-For}
	log_append inbound_x_forwarded_for {http.vars.inbound_xff}

	# Upstreams get one answer: the address this edge just rate-limited on.
	# reverse_proxy appends this edge's peer when that peer is trusted and
	# replaces the header with the peer otherwise, so the backend receives
	# "<visitor>, 10.251.0.13" through the tunnel and just the peer on any other
	# route. Nothing a visitor wrote survives, including for backend code that
	# reads the leftmost entry or X-Real-IP (audit fields). {client_ip} is decided
	# when the request arrives, so dropping the header here does not change it.
	request_header X-Forwarded-For {client_ip}
	request_header -X-Real-IP
	request_header -Cf-Connecting-IP

	import security_headers
	import report_only_csp
	import sane_limits
	import public_onboarding_limits
	encode gzip zstd

	route {
		import public_onboarding_api
		import public_downloads
		import disabled_wallet_secret_routes
		handle {
			reverse_proxy wrfcoin-testnet-frontend:5000 {
				health_uri /health
				health_interval 30s
			}
		}
	}
}
