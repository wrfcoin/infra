    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Live N5 operator truth. Read-only baseline observed 2026-07-23: BFT finality active=0 (inactive), validator participation=0 (runtime source unwired), connected peers=1 (connected but not redundant). These values are never replaced with synthetic healthy defaults.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "BFT finality active" },
            "properties": [
              { "id": "mappings", "value": [{ "options": { "0": { "color": "red", "text": "Inactive (0)" }, "1": { "color": "green", "text": "Active (1)" } }, "type": "value" }] },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Validator participation" },
            "properties": [
              { "id": "max", "value": 1 },
              { "id": "min", "value": 0 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "#F59E0B", "value": 0.67 }, { "color": "green", "value": 0.8 }] } },
              { "id": "unit", "value": "percentunit" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Connected peers" },
            "properties": [
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "#F59E0B", "value": 1 }, { "color": "green", "value": 2 }] } }
