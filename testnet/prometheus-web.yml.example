# Prometheus basic auth configuration
# Generated by setup-env.sh — do not edit manually unless regenerating.
#
# To regenerate manually:
#   htpasswd -nbBC 10 '' 'YOUR_PASSWORD' | cut -d: -f2
# Or with Python:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt(rounds=10)).decode())"
#
# Do not commit the real prometheus-web.yml to version control.
# After enabling basic auth, update Grafana's Prometheus datasource
# to include basic auth credentials (admin / your password).

basic_auth_users:
  admin: $2y$10$EXAMPLE_HASH_REPLACE_ME
