{
  "name": "testnet",
  "services": {
    "wrfcoin-node": {
      "container_name": "wrfcoin-testnet-node",
      "image": "wrfcoin/native-chain:testnet-local",
      "volumes": [
        "./config/node.toml:/app/config/node.toml:ro",
        "node-data:/app/data"
      ]
    }
  },
  "volumes": {
    "node-data": {
      "name": "testnet_node-data"
    }
  }
}
