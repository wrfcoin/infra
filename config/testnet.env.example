# ==============================================================================
# WRFCoin Testnet Environment Variables
# Copy to testnet/.env and fill in your values.
# DO NOT commit this file with real values to version control.
#
# This is the canonical reference for testnet deployment on the N5 Pro.
# It duplicates testnet/.env.testnet.example with explicit environment identity
# fields added to support the multi-env promotion pipeline (issue #116).
#
# Image tag convention: wrfcoin/<service>:testnet-<short-sha>
#   - Images are promoted from staging (no rebuild): short-sha matches staging build.
#   - To promote: scripts/promote-environment.sh --from=staging --to=testnet
#
# Generate secrets: openssl rand -base64 32
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Identity
# ------------------------------------------------------------------------------

WRFCOIN_ENV=testnet
WRFCOIN_NETWORK_ID=testnet
WRFCOIN_CHAIN_ID=777

# Image SHA — set by promote-environment.sh, do not set manually
WRFCOIN_IMAGE_TAG=testnet-REPLACE_with_short_sha

# ------------------------------------------------------------------------------
# Database (Required)
# ------------------------------------------------------------------------------

POSTGRES_PASSWORD=REPLACE_with_strong_password
DATABASE_URL=postgresql://wrfcoin:REPLACE_with_strong_password@postgres:5432/wrfcoin

# ------------------------------------------------------------------------------
# Cache (Required)
# ------------------------------------------------------------------------------

REDIS_PASSWORD=REPLACE_with_strong_password
REDIS_URL=redis://:REPLACE_with_strong_password@redis:6379

# ------------------------------------------------------------------------------
# Security (Required)
# ------------------------------------------------------------------------------

JWT_SECRET=REPLACE_with_strong_secret_min_32_chars
OAUTH_STATE_SECRET=REPLACE_with_strong_secret_min_32_chars
API_KEY_ENCRYPTION_KEY=REPLACE_with_hex_32_bytes
RPC_API_KEY=REPLACE_with_strong_token
ADMIN_TOKEN=REPLACE_with_strong_admin_token

# Grafana admin dashboard
GRAFANA_ADMIN_PASSWORD=REPLACE_with_strong_password
GRAFANA_ADMIN_USER=admin

# Prometheus basic auth
PROMETHEUS_ADMIN_PASSWORD=REPLACE_with_strong_password
PROMETHEUS_BEARER_TOKEN=REPLACE_with_strong_token

# ------------------------------------------------------------------------------
# Faucet
# ------------------------------------------------------------------------------

FAUCET_RPC_URL=http://wrfcoin-node:8556
FAUCET_RPC_METHOD=wrf_transfer
FAUCET_AMOUNT=10
FAUCET_DENOMINATION=WRF
FAUCET_RATE_LIMIT_SECONDS=86400
FAUCET_RATE_LIMIT_PREFIX=faucet:ip:
FAUCET_WALLET_PRIVKEY=REPLACE_with_testnet_wallet_private_key
FAUCET_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
FAUCET_CAPTCHA_PROVIDER=off
FAUCET_HCAPTCHA_SITEKEY=
FAUCET_HCAPTCHA_SECRET=
FAUCET_RECAPTCHA_SITEKEY=
FAUCET_RECAPTCHA_SECRET=
FAUCET_RECAPTCHA_MIN_SCORE=0.5
FAUCET_DISCORD_WEBHOOK_URL=
FAUCET_DISCORD_WEBHOOK_USERNAME=WRFCoin Faucet
FAUCET_DISCORD_WEBHOOK_AVATAR_URL=

# ------------------------------------------------------------------------------
# Blockchain Node
# ------------------------------------------------------------------------------

BLOCKCHAIN_NODE_URL=http://wrfcoin-node:8556
CORE4_API_URL=http://wrfcoin-node:8556

# Set to true ONLY for ephemeral dev/CI volumes. Production / testnet operators should leave this false.
ALLOW_UNENCRYPTED_STORAGE=false
WRFCOIN_STORAGE_ENCRYPTION_KEY=REPLACE_with_hex_32_bytes

# Node authentication tokens
WRFCOIN_OPERATOR_TOKEN=REPLACE_with_strong_token
WRFCOIN_CONTRIBUTOR_TOKEN=
WRFCOIN_ORACLE_TOKEN=
WRFCOIN_READER_TOKEN=
WRFCOIN_SNAPSHOT_SIGNER_PRIVATE_KEY=
WRFCOIN_CONTRIBUTOR_ADDRESS=0x0000000000000000000000000000000000000b02

# HSM-backed node signing (optional)
# Default path below is the CT 101 YubiKey rollout target.
WRFCOIN_HSM_MODE=yubikey
WRFCOIN_HSM_PIN=REPLACE_with_hsm_pin
WRFCOIN_HSM_MODULE_PATH=/usr/lib/x86_64-linux-gnu/libykcs11.so
WRFCOIN_HSM_TOKEN_LABEL=YubiKey PIV #REPLACE
WRFCOIN_HSM_KEY_LABEL=Private key for Digital Signature
WRFCOIN_HSM_PUBKEY_LABEL=Public key for Digital Signature
WRFCOIN_HSM_PIN_ENV=WRFCOIN_HSM_PIN
# Rotate exposed HSM PINs on the token before launch; never commit old values.
# SoftHSM2 fallback:
# WRFCOIN_HSM_MODE=softhsm
# WRFCOIN_HSM_MODULE_PATH=/usr/lib/softhsm/libsofthsm2.so
# WRFCOIN_HSM_TOKEN_LABEL=wrfcoin-validator
# WRFCOIN_HSM_KEY_LABEL=wrfcoin-signing-key

# Bootstrap peers — required for a connected testnet node
# Format: /ip4/<IP>/tcp/9000/p2p/<PEER_ID>
BOOTSTRAP_PEERS=
WRFCOIN_P2P_EXTERNAL_ADDR=
WRFCOIN_P2P_RELAY_ADDRESSES=

# Seed node (if running --profile seed)
SEED_BOOTSTRAP_PEERS=
WRFCOIN_SEED_P2P_EXTERNAL_ADDR=

# ------------------------------------------------------------------------------
# App Ports (localhost-only — reverse proxy or SSH tunnel for external access)
# ------------------------------------------------------------------------------

CORS_ORIGIN=https://wrfcoin-testnet.taila1c049.ts.net

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------

RUST_LOG=info
LOG_LEVEL=info
ENABLE_CONSOLE_LOGS=true
DISABLE_FILE_LOG_TRANSPORTS=true

# ------------------------------------------------------------------------------
# Tuning
# ------------------------------------------------------------------------------

DB_POOL_SIZE=8
WRFCOIN_CHECKPOINT_INTERVAL=100
WRFCOIN_GOSSIPSUB_MESH_N=4
WRFCOIN_GOSSIPSUB_MESH_N_LOW=3
WRFCOIN_GOSSIPSUB_MESH_N_HIGH=8
WRFCOIN_GOSSIPSUB_MESH_OUTBOUND_MIN=2
WRFCOIN_GOSSIPSUB_FLOOD_PUBLISH=false
WRFCOIN_IDLE_CONNECTION_TIMEOUT_SECS=300
WRFCOIN_MAX_PEERS_PER_SUBNET=2
WRFCOIN_INLINE_DATA_MAX=65536
PAYMASTER_CHAIN_ID=${WRFCOIN_CHAIN_ID:-777}
NODE_OPTIONS=--max-old-space-size=768 --max-semi-space-size=32

# ------------------------------------------------------------------------------
# Workspace Root
# ------------------------------------------------------------------------------

WRFCOIN_ROOT=/root/wrfcoin

# ------------------------------------------------------------------------------
# Weather Collection (docker compose --profile collector up)
# ------------------------------------------------------------------------------

AMBIENT_WEATHER_APP_KEY=
AMBIENT_WEATHER_API_KEY=
CORE4_PATH=${WRFCOIN_ROOT:-/root/wrfcoin}/core4

# ------------------------------------------------------------------------------
# HashiCorp Vault
# ------------------------------------------------------------------------------

VAULT_ADDR=https://vault.wrfcoin.io
VAULT_ENDPOINT=https://vault.wrfcoin.io
HSM_ENDPOINT=
HSM_KEY_ID=
