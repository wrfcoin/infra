# ==============================================================================
# WRFCoin Development Environment Variables
# Copy to .env and fill in your values. DO NOT commit .env to version control.
#
# Used by: docker-compose.dev.yml (postgres + redis only)
# App services (node, backend) are run directly from source during development.
#
# Generate secrets: openssl rand -base64 32
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Identity
# ------------------------------------------------------------------------------

WRFCOIN_ENV=dev
WRFCOIN_NETWORK_ID=dev
WRFCOIN_CHAIN_ID=7777

# ------------------------------------------------------------------------------
# Database (Required)
# ------------------------------------------------------------------------------

POSTGRES_DEV_PASSWORD=wrfcoin_dev_CHANGE_ME
# Connection string used by backend services
DATABASE_URL=postgresql://wrfcoin:wrfcoin_dev_CHANGE_ME@localhost:5432/wrfcoin

# ------------------------------------------------------------------------------
# Cache (Required)
# ------------------------------------------------------------------------------

REDIS_PASSWORD=redis_dev_CHANGE_ME
# Connection string used by backend services
REDIS_URL=redis://:redis_dev_CHANGE_ME@localhost:6379

# ------------------------------------------------------------------------------
# Security (Required)
# ------------------------------------------------------------------------------

# JWT signing secret — 32+ chars
JWT_SECRET=dev_jwt_secret_CHANGE_ME_min_32_chars_long

# AES-256-GCM key for API key encryption (hex-encoded 32 bytes)
API_KEY_ENCRYPTION_KEY=

# Local RPC/admin tokens
RPC_API_KEY=dev_rpc_api_key_CHANGE_ME
ADMIN_TOKEN=dev_admin_token_CHANGE_ME_min_32_chars

# ------------------------------------------------------------------------------
# Blockchain Node
# ------------------------------------------------------------------------------

BLOCKCHAIN_NODE_URL=http://localhost:8556
CORE4_API_URL=http://localhost:8556

# Set to true ONLY for ephemeral dev/CI volumes. Production / testnet operators should leave this false.
ALLOW_UNENCRYPTED_STORAGE=false
WRFCOIN_STORAGE_ENCRYPTION_KEY=

# Bootstrap peers — leave empty for isolated dev node
BOOTSTRAP_PEERS=

# ------------------------------------------------------------------------------
# App Ports (matches docker-compose.dev.yml defaults)
# ------------------------------------------------------------------------------

# These default host ports stay bound to localhost in dev.
POSTGRES_PORT=5432
REDIS_PORT=6379
NODE_API_PORT=8556
BACKEND_PORT=4001

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------

RUST_LOG=debug
LOG_LEVEL=debug
ENABLE_CONSOLE_LOGS=true
DISABLE_FILE_LOG_TRANSPORTS=true

# ------------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------------

VITE_API_URL=http://localhost:4001
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Workspace Root (used by docker-compose.dev.yml build contexts)
# ------------------------------------------------------------------------------

WRFCOIN_ROOT=/home/your-user/wrfcoin
