# Legacy RTL-433 compose is loopback-only and requires explicit credentials.
# Copy to docker/.env.rtl433 and replace every REPLACE_ value before rendering
# the stack with:
#   docker compose --env-file docker/.env.rtl433 \
#     -f docker/docker-compose.rtl433.yml config
POSTGRES_USER=wrfcoin
POSTGRES_PASSWORD=REPLACE_with_strong_url_safe_password
POSTGRES_DB=wrfcoin
REDIS_PASSWORD=REPLACE_with_strong_url_safe_password

# Mosquitto and rtl433_ingestion share these credentials. MQTT_PASSWORD is
# inserted into MQTT_BROKER_URL as URL userinfo, so it MUST use only the
# RFC 3986 URL-unreserved alphabet: A-Z a-z 0-9 - . _ ~
# docker/provision-mosquitto-auth.sh enforces this before provisioning.
MQTT_USERNAME=wrfcoin_rtl433
MQTT_PASSWORD=REPLACE_with_strong_URL_unreserved_password

# Optional loopback host-port overrides.
RTL433_MQTT_PORT=1884
MQTT_PORT=1883
MQTT_WEBSOCKET_PORT=9001
IOT_GATEWAY_MQTT_PORT=1885
IOT_GATEWAY_COAP_PORT=5683
IOT_GATEWAY_HTTP_PORT=5684
RTL433_INGESTION_PORT=3052
BACKEND_PORT=4001
