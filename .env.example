# WRFCoin Infra — Environment Variable Reference
# Copy to .env and fill in values before running docker-compose.
# DO NOT commit .env — it is gitignored.

# ─── Grafana ────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=REPLACE_with_strong_password

# ─── RPC / Admin Auth ───────────────────────────────────────────────────────
RPC_API_KEY=REPLACE_with_strong_token
ADMIN_TOKEN=REPLACE_with_strong_admin_token

# ─── AlertManager (non-secret SMTP config) ──────────────────────────────────
SMTP_SMARTHOST=smtp.example.com:587
SMTP_FROM=alerts@wrfcoin.com
SMTP_USERNAME=alerts@wrfcoin.com
ALERT_EMAIL_TO=ops@wrfcoin.com
SECURITY_EMAIL_TO=security@wrfcoin.com

# ─── AlertManager secrets (mounted as files — NOT env vars) ─────────────────
# SMTP_PASSWORD and SLACK_WEBHOOK_URL are read from files at /run/secrets/
# to prevent exposure via `docker inspect`.
#
# Create the secret files before starting the monitoring stack:
#
#   printf 'your-smtp-password'  > infra/monitoring/alertmanager/secrets/smtp_password
#   printf 'https://hooks.slack.com/services/...' > infra/monitoring/alertmanager/secrets/slack_webhook
#   chmod 600 infra/monitoring/alertmanager/secrets/*
#
# To store secrets outside this repo (recommended for production), set:
#   ALERTMANAGER_SECRETS_DIR=/path/to/secure/secrets/dir
# The directory must contain files named `smtp_password` and `slack_webhook`.
# ALERTMANAGER_SECRETS_DIR=./alertmanager/secrets

# Ecowitt discovery: comma-separated private LAN host addresses (maximum 16).
# Empty supplies no installation hosts; backend generic fallback probes remain active.
STATION_DISCOVERY_ECOWITT_HOSTS=

# Node-pay snapshot receipts: the bond's service_alias, e.g. node-ws.
# Set per node before the next planned restart; empty is not a bonded identity.
WRFCOIN_SERVICE_ID=
