{
  "dashboard": {
    "id": null,
    "uid": "contract-testing-monitoring",
    "title": "WRFCoin Contract Testing & Pact Monitoring",
    "tags": ["wrfcoin", "contract-testing", "pact", "testing", "qa"],
    "style": "dark",
    "timezone": "browser",
    "refresh": "30s",
    "schemaVersion": 39,
    "version": 1,
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m"],
      "time_options": ["1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "templating": {
      "list": [
        {
          "name": "consumer",
          "type": "query",
          "query": "label_values(pact_contract_tests_total, consumer)",
          "refresh": 1,
          "includeAll": true,
          "allValue": ".*",
          "multi": true,
          "current": {
            "selected": false,
            "text": "All",
            "value": "$__all"
          }
        },
        {
          "name": "provider",
          "type": "query",
          "query": "label_values(pact_contract_tests_total, provider)",
          "refresh": 1,
          "includeAll": true,
          "allValue": ".*",
          "multi": true,
          "current": {
            "selected": false,
            "text": "All",
            "value": "$__all"
          }
        },
        {
          "name": "test_type",
          "type": "custom",
          "options": [
            { "text": "All", "value": ".*", "selected": true },
            { "text": "Consumer", "value": "consumer", "selected": false },
            { "text": "Provider", "value": "provider", "selected": false }
          ],
          "multi": true,
          "includeAll": true
        },
        {
          "name": "time_range",
          "type": "interval",
          "query": "5m,15m,30m,1h,6h",
          "current": {
            "selected": false,
            "text": "15m",
            "value": "15m"
          }
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "Contract Test Failures",
          "datasource": "Prometheus",
          "enable": true,
          "expr": "increase(pact_contract_test_failures_total[5m]) > 0"
        },
        {
          "name": "Pact Broker Events",
          "datasource": "Prometheus",
          "enable": true,
          "expr": "changes(pact_broker_publish_timestamp[10m]) > 0"
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Contract Test Overview",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "collapsed": false
      },
      {
        "id": 2,
        "title": "Contract Test Success Rate",
        "type": "stat",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
        "targets": [
          {
            "expr": "(sum(rate(pact_contract_tests_passed_total{consumer=~\"$consumer\",provider=~\"$provider\"}[$time_range])) / sum(rate(pact_contract_tests_total{consumer=~\"$consumer\",provider=~\"$provider\"}[$time_range]))) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "yellow", "value": 70 },
                { "color": "green", "value": 90 }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Total Contract Tests Today",
        "type": "stat",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
        "targets": [
          {
            "expr": "sum(increase(pact_contract_tests_total{consumer=~\"$consumer\",provider=~\"$provider\"}[24h]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "palette-classic" }
          }
        }
      },
      {
        "id": 4,
        "title": "Contract Test Results by Consumer/Provider",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
        "targets": [
          {
            "expr": "sum(rate(pact_contract_tests_passed_total{consumer=~\"$consumer\",provider=~\"$provider\"}[$time_range])) by (consumer, provider)",
            "refId": "A",
            "legendFormat": "{{consumer}} -> {{provider}} (Passed)"
          },
          {
            "expr": "sum(rate(pact_contract_test_failures_total{consumer=~\"$consumer\",provider=~\"$provider\"}[$time_range])) by (consumer, provider)",
            "refId": "B",
            "legendFormat": "{{consumer}} -> {{provider}} (Failed)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear"
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Pact Broker Metrics",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
        "collapsed": false
      },
      {
        "id": 6,
        "title": "Pact Publications per Hour",
        "type": "bargauge",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
        "targets": [
          {
            "expr": "sum(rate(pact_broker_publications_total{consumer=~\"$consumer\"}[1h])) by (consumer)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": { "mode": "continuous-GrYlRd" }
          }
        }
      },
      {
        "id": 7,
        "title": "Verification Results",
        "type": "piechart",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
        "targets": [
          {
            "expr": "sum(pact_verification_results_total) by (result)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "displayMode": "table",
              "orientation": "horizontal"
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Contract Coverage Analysis",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
        "collapsed": false
      },
      {
        "id": 9,
        "title": "API Endpoint Coverage",
        "type": "table",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
        "targets": [
          {
            "expr": "sum(pact_contract_endpoint_coverage{consumer=~\"$consumer\",provider=~\"$provider\"}) by (endpoint, method)",
            "refId": "A",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "displayMode": "color-background"
            },
            "thresholds": {
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "yellow", "value": 0.5 },
                { "color": "green", "value": 1 }
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "title": "Contract Test Duration",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(pact_contract_test_duration_seconds_bucket{consumer=~\"$consumer\",provider=~\"$provider\"}[$time_range])) by (le, consumer, provider))",
            "refId": "A",
            "legendFormat": "95th percentile - {{consumer}} -> {{provider}}"
          },
          {
            "expr": "histogram_quantile(0.50, sum(rate(pact_contract_test_duration_seconds_bucket{consumer=~\"$consumer\",provider=~\"$provider\"}[$time_range])) by (le, consumer, provider))",
            "refId": "B",
            "legendFormat": "50th percentile - {{consumer}} -> {{provider}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 11,
        "title": "Test Failure Analysis",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
        "collapsed": false
      },
      {
        "id": 12,
        "title": "Failure Rate by Error Type",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
        "targets": [
          {
            "expr": "sum(rate(pact_contract_test_failures_total{consumer=~\"$consumer\",provider=~\"$provider\"}[$time_range])) by (error_type)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 80
            }
          }
        }
      },
      {
        "id": 13,
        "title": "Recent Test Failures",
        "type": "logs",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
        "targets": [
          {
            "expr": "{job=\"pact-tests\"} |= \"FAILED\" | json",
            "refId": "A"
          }
        ]
      },
      {
        "id": 14,
        "title": "Historical Trends",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 },
        "collapsed": false
      },
      {
        "id": 15,
        "title": "Weekly Contract Test Trends",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 45 },
        "targets": [
          {
            "expr": "sum(increase(pact_contract_tests_total{consumer=~\"$consumer\",provider=~\"$provider\"}[7d]))",
            "refId": "A",
            "legendFormat": "Total Tests (7d)"
          },
          {
            "expr": "sum(increase(pact_contract_tests_passed_total{consumer=~\"$consumer\",provider=~\"$provider\"}[7d]))",
            "refId": "B",
            "legendFormat": "Passed Tests (7d)"
          },
          {
            "expr": "sum(increase(pact_contract_test_failures_total{consumer=~\"$consumer\",provider=~\"$provider\"}[7d]))",
            "refId": "C",
            "legendFormat": "Failed Tests (7d)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      },
      {
        "id": 16,
        "title": "Pact Broker Health",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 53 },
        "collapsed": false
      },
      {
        "id": 17,
        "title": "Broker Response Time",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 54 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(pact_broker_http_request_duration_seconds_bucket[5m])) by (le, method, route))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 18,
        "title": "Broker Storage Metrics",
        "type": "stat",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 54 },
        "targets": [
          {
            "expr": "pact_broker_storage_contracts_total",
            "refId": "A",
            "legendFormat": "Total Contracts"
          },
          {
            "expr": "pact_broker_storage_verifications_total",
            "refId": "B",
            "legendFormat": "Total Verifications"
          }
        ]
      }
    ]
  }
}
