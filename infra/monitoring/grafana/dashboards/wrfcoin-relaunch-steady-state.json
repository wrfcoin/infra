{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Steady-state and flapping view for the relaunched launch-critical stack.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "description": "Availability over the last 15 minutes. Values below 1 indicate intermittent failures or recent restarts.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "avg_over_time(probe_success{job=~\"wrfcoin-launch-health|wrfcoin-launch-websocket\"}[15m])",
          "instant": true,
          "legendFormat": "{{service}} {{endpoint}}",
          "refId": "A"
        }
      ],
      "title": "15m Availability by Probe",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "description": "Probe flapping count over the last 30 minutes.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "changes(probe_success{job=~\"wrfcoin-launch-health|wrfcoin-launch-websocket\"}[30m])",
          "instant": true,
          "legendFormat": "{{service}} {{endpoint}}",
          "refId": "A"
        }
      ],
      "title": "Probe State Changes (30m)",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "description": "Probe latency over time across the launch path.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "probe_duration_seconds{job=~\"wrfcoin-launch-health|wrfcoin-launch-websocket\"}",
          "legendFormat": "{{service}} {{endpoint}}",
          "refId": "A"
        }
      ],
      "title": "Probe Duration",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "description": "Current launch-path HTTP status codes returned by blackbox probes.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "probe_http_status_code{job=~\"wrfcoin-launch-health|wrfcoin-launch-websocket\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Current Probe HTTP Status",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "Time": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "Value": "HTTP Status",
              "endpoint": "Endpoint",
              "service": "Service"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "description": "Main-api process restarts detectable through Prometheus process metrics.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 17
      },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "changes(process_start_time_seconds{job=\"wrfcoin-main-api\"}[30m])",
          "refId": "A"
        }
      ],
      "title": "Main API Restarts (30m)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "description": "Current main-api error ratio from existing HTTP request metrics.",
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 17
      },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(rate(wrfcoin_http_requests_total{job=\"wrfcoin-main-api\",status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(wrfcoin_http_requests_total{job=\"wrfcoin-main-api\"}[5m])), 1)",
          "refId": "A"
        }
      ],
      "title": "Main API 5xx Ratio",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "description": "Current main-api memory and event-loop lag trend.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Resident Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Event Loop p99"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"wrfcoin-main-api\"}",
          "legendFormat": "Resident Memory",
          "refId": "A"
        },
        {
          "expr": "nodejs_eventloop_lag_p99_seconds{job=\"wrfcoin-main-api\"}",
          "legendFormat": "Event Loop p99",
          "refId": "B"
        }
      ],
      "title": "Main API Runtime Trend",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "description": "Operationally important gaps that still need future instrumentation work.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 8,
      "options": {
        "content": "### Current gaps\n- `compute-agent` and `compute-contribution` are represented here through blackbox health/readiness probes, not native Prometheus counters or histograms.\n- `launch_api` health is visible, but chain-specific internals still need richer metrics for deeper dashboarding.\n- Relaunch smoke matrix fields from `relaunch-report.json` are not yet exported as Prometheus metrics, so this board cannot show historical `service start` / `steady state` pass-fail timelines.\n- WebSocket visibility is limited to upgrade success for `main-api /ws`; deeper websocket session instrumentation still requires service changes outside this lane.",
        "mode": "markdown"
      },
      "title": "Future Instrumentation Needed",
      "type": "text"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "wrfcoin",
    "relaunch",
    "steady-state",
    "operations"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "WRF Relaunch Steady State",
  "uid": "wrf-relaunch-steady",
  "version": 1,
  "weekStart": ""
}
