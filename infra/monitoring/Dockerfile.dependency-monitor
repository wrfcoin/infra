FROM node:24-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53

LABEL maintainer="WRFCoin Development Team"
LABEL description="Service Dependency Monitoring Agent"

# Create app directory
WORKDIR /app

# Install system dependencies
RUN apk add --no-cache \
    curl \
    jq \
    bash \
    graphviz \
    && rm -rf /var/cache/apk/*

# Create package.json for dependencies
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

# Copy application files
COPY dependency-monitor.js ./
COPY lib/ ./lib/
COPY generate-service-dependency-map.js ./
COPY ./dependency-maps /app/maps/
COPY ./health-check.sh ./
RUN chmod +x health-check.sh

# Create logs directory
RUN mkdir -p logs

# Run as a non-root user like the other monitoring containers.
RUN addgroup -g 1001 -S nodejs && \
    adduser -S -u 1001 -G nodejs nodejs && \
    chown -R nodejs:nodejs /app

# Expose monitoring port
EXPOSE 9200

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD ./health-check.sh

# Run the monitoring service
USER nodejs
CMD ["node", "dependency-monitor.js"]
