# Dockerfile for Contract Test Metrics Collector

# node:25-alpine
FROM node:24-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53

LABEL maintainer="WRFCoin DevOps Team"
LABEL description="Contract Test Metrics Collector for Prometheus integration"

# Install curl for healthchecks
RUN apk add --no-cache curl

# Create app directory
WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund && npm cache clean --force

# Copy application code
COPY contract-test-metrics-collector.js ./
COPY lib/ ./lib/

# Create necessary directories
RUN mkdir -p /app/pacts /app/logs /app/reports /app/data

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S -u 1001 -G nodejs nodejs

# Change ownership of app directory
RUN chown -R nodejs:nodejs /app

# Switch to non-root user
USER nodejs

# Expose port
EXPOSE 9095

# Add health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:9095/health || exit 1

# Start the application
CMD ["node", "contract-test-metrics-collector.js"]
