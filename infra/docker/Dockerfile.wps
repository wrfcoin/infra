# Dockerfile.wps — WRF Preprocessing System (WPS) container
# Multi-stage build for WPS 4.5 with gfortran (serial)
#
# Build time: ~15-20 minutes depending on hardware
# Final image size: ~500MB
#
# Usage:
#   docker build -f Dockerfile.wps -t wrfcoin/wps:4.5 .
#   docker run -v geog-data:/data/geog -v wps-output:/data/output wrfcoin/wps:4.5

ARG WPS_VERSION=4.5
ARG WRF_VERSION=4.5.2
ARG BASE_IMAGE=ubuntu:22.04@sha256:962f6cadeae0ea6284001009daa4cc9a8c37e75d1f5191cf0eb83fe565b63dd7
# Pinned SHA256 for the WPS v4.5 source tarball from GitHub Releases.
# See infra/docker/wrf/SHA256SUMS.txt for the current pinned values.
ARG WPS_SHA256=3cb29107f85b81af05b7dd494e5d4a13cf1b33b87d7e2911a64a7abc59bf55f3

# =============================================================================
# Stage 1: Builder — compile WPS from source
# =============================================================================
FROM ${BASE_IMAGE} AS builder

ARG WPS_VERSION
ARG WRF_VERSION
ARG WPS_SHA256

ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gfortran \
    cpp \
    m4 \
    make \
    wget \
    ca-certificates \
    libnetcdf-dev \
    libnetcdff-dev \
    libhdf5-dev \
    cmake \
    libpng-dev \
    zlib1g-dev \
    mpich \
    libmpich-dev \
    csh \
    perl \
    file \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables for NetCDF/HDF5
ENV NETCDF=/usr
ENV HDF5=/usr

# JasPer is not packaged on ubuntu:22.04 (no libjasper-dev/libjasper4), so build
# a pinned release from source. Static, so the runtime stage needs no JasPer
# package. WPS/WRF configure use JASPERLIB/JASPERINC for GRIB2 support.
ARG JASPER_VERSION=2.0.33
ARG JASPER_SHA256=38b8f74565ee9e7fec44657e69adb5c9b2a966ca5947ced5717cde18a7d2eca6
RUN wget -q "https://github.com/jasper-software/jasper/archive/refs/tags/version-${JASPER_VERSION}.tar.gz" \
    -O /tmp/jasper.tar.gz \
    && echo "${JASPER_SHA256}  /tmp/jasper.tar.gz" | sha256sum -c - \
    && tar xzf /tmp/jasper.tar.gz -C /tmp \
    && cmake -S /tmp/jasper-version-${JASPER_VERSION} -B /tmp/jasper-build \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/jasper \
        -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DJAS_ENABLE_SHARED=OFF -DJAS_ENABLE_PROGRAMS=OFF -DJAS_ENABLE_DOC=OFF \
        -DJAS_ENABLE_LIBJPEG=OFF -DALLOW_IN_SOURCE_BUILD=OFF \
    && cmake --build /tmp/jasper-build -j"$(nproc)" \
    && cmake --install /tmp/jasper-build \
    && rm -rf /tmp/jasper.tar.gz /tmp/jasper-version-${JASPER_VERSION} /tmp/jasper-build
ENV JASPERLIB=/opt/jasper/lib
ENV JASPERINC=/opt/jasper/include

# Debian names the HDF5 high-level Fortran library libhdf5hl_fortran; WRF's
# configure links -lhdf5_hl_fortran, which otherwise fails with
# "ld: cannot find -lhdf5_hl_fortran" while linking the executables.
RUN ln -s /usr/lib/x86_64-linux-gnu/hdf5/serial/libhdf5hl_fortran.so /usr/lib/x86_64-linux-gnu/libhdf5_hl_fortran.so \
    && ln -s /usr/lib/x86_64-linux-gnu/hdf5/serial/libhdf5hl_fortran.a /usr/lib/x86_64-linux-gnu/libhdf5_hl_fortran.a

WORKDIR /build

# Download WPS source and verify the pinned SHA256 checksum.
RUN wget -q "https://github.com/wrf-model/WPS/archive/refs/tags/v${WPS_VERSION}.tar.gz" \
    -O wps.tar.gz \
    && echo "${WPS_SHA256}  wps.tar.gz" | sha256sum -c - \
    && tar xzf wps.tar.gz \
    && rm wps.tar.gz \
    && mv WPS-${WPS_VERSION} WPS

WORKDIR /build/WPS

# Configure WPS for gfortran serial (option 1)
# The configure script is interactive; pipe the selection
# Option 1 = gfortran serial (WPS does not typically use MPI itself)
RUN echo "1" | ./configure

# Build WPS executables
# NOTE: WPS requires WRF to be built first for full functionality, but the
# executables can be compiled standalone for container packaging
RUN ./compile 2>&1 | tee /build/compile_wps.log \
    && ls -la geogrid.exe ungrib.exe metgrid.exe

# =============================================================================
# Stage 2: Runtime — minimal image with WPS binaries
# =============================================================================
FROM ${BASE_IMAGE} AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# Install runtime libraries only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnetcdff7 \
    libhdf5-103-1 \
    libhdf5-fortran-102 \
    libhdf5-hl-fortran-100 \
    libpng16-16 \
    mpich \
    bash \
    wget \
    bzip2 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy WPS binaries and supporting files from builder
COPY --from=builder /build/WPS/geogrid.exe /wps/
COPY --from=builder /build/WPS/ungrib.exe /wps/
COPY --from=builder /build/WPS/metgrid.exe /wps/
COPY --from=builder /build/WPS/geogrid/ /wps/geogrid/
COPY --from=builder /build/WPS/ungrib/ /wps/ungrib/
COPY --from=builder /build/WPS/metgrid/ /wps/metgrid/
COPY --from=builder /build/WPS/link_grib.csh /wps/
COPY --from=builder /build/WPS/util/ /wps/util/

# Copy healthcheck script
COPY healthcheck-wrf.sh /usr/local/bin/healthcheck-wrf.sh
RUN chmod +x /usr/local/bin/healthcheck-wrf.sh

# Copy sample namelist
COPY namelist.wps /wps/namelist.wps.sample

WORKDIR /wps

# Create data directories
RUN mkdir -p /data/geog /data/output

VOLUME ["/data/geog", "/data/output"]

HEALTHCHECK --interval=60s --timeout=10s --retries=3 \
    CMD /usr/local/bin/healthcheck-wrf.sh --wps

# Copy WPS entrypoint (auto-downloads geography data if needed)
COPY entrypoint-wps.sh /usr/local/bin/entrypoint-wps.sh
RUN chmod +x /usr/local/bin/entrypoint-wps.sh

# Run as non-root user
RUN useradd -m -s /bin/bash wrfuser && chown -R wrfuser:wrfuser /wps /data
USER wrfuser

ENTRYPOINT ["/usr/local/bin/entrypoint-wps.sh"]
CMD ["/bin/bash"]
