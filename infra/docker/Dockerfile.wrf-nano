# Dockerfile.wrf-nano — Minimal serial WRF build for CI testing
# Multi-stage build, no MPI overhead, smaller footprint (~500MB target)
#
# Build time: ~20-30 minutes (serial is slightly faster than dmpar)
# Final image size: ~500MB (no MPI libraries, no build toolchain)
#
# This image is intended for CI pipelines where a lightweight WRF binary is
# needed to validate configurations, namelists, and basic execution paths.
#
# Usage:
#   docker build -f Dockerfile.wrf-nano -t wrfcoin/wrf-nano:4.5.2 .
#   docker run wrfcoin/wrf-nano:4.5.2 -c "/wrf/main/wrf.exe --help || true"

ARG WRF_VERSION=4.5.2
ARG BASE_IMAGE=ubuntu:22.04@sha256:962f6cadeae0ea6284001009daa4cc9a8c37e75d1f5191cf0eb83fe565b63dd7
# Pinned SHA256 for the WRF v4.5.2 release-asset tarball (v4.5.2.tar.gz). Unlike
# the auto-generated archive/refs/tags tarball, the release asset includes the
# NoahMP submodule sources that `compile em_real` requires.
# See infra/docker/wrf/SHA256SUMS.txt for the current pinned values.
ARG WRF_SHA256=408ba6aa60d9cd51d6bad2fa075a3d37000eb581b5d124162885b049c892bbdc

# =============================================================================
# Stage 1: Builder — compile WRF serial from source
# =============================================================================
FROM ${BASE_IMAGE} AS builder

ARG WRF_VERSION
ARG WRF_SHA256

ENV DEBIAN_FRONTEND=noninteractive

# Install minimal dependencies for serial build (no MPI)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gfortran \
    cpp \
    gcc \
    g++ \
    m4 \
    make \
    wget \
    ca-certificates \
    libnetcdf-dev \
    libnetcdff-dev \
    libhdf5-dev \
    libpng-dev \
    zlib1g-dev \
    csh \
    tcsh \
    perl \
    file \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables for WRF build
# JasPer (GRIB2 output) is deliberately not installed: libjasper-dev/libjasper4
# are not available on ubuntu:22.04. With JASPERLIB/JASPERINC unset, WRF's
# configure builds without GRIB2 support; this CI image only needs the netCDF
# I/O path (wrf.exe/real.exe/ndown.exe/tc.exe).
ENV NETCDF=/usr
ENV HDF5=/usr
ENV WRF_DIR=/build/WRF
ENV WRFIO_NCD_LARGE_FILE_SUPPORT=1

WORKDIR /build

# Download and extract WRF source, verifying the pinned checksum.
RUN wget -q "https://github.com/wrf-model/WRF/releases/download/v${WRF_VERSION}/v${WRF_VERSION}.tar.gz" \
    -O wrf.tar.gz \
    && echo "${WRF_SHA256}  wrf.tar.gz" | sha256sum -c - \
    && tar xzf wrf.tar.gz \
    && rm wrf.tar.gz \
    && mv WRFV${WRF_VERSION} WRF

WORKDIR /build/WRF

# Configure WRF for serial gfortran (no MPI)
# Option 32 = serial gfortran on Linux x86_64
# Second input "1" selects basic nesting
RUN printf "32\n1\n" | ./configure

# Compile WRF em_real case (serial)
# NOTE: Takes 20-30 minutes. Docker layer caching avoids rebuilds when only
# downstream layers change.
RUN ./compile em_real 2>&1 | tee /build/compile_wrf.log \
    && ls -la main/wrf.exe main/real.exe

# =============================================================================
# Stage 2: Runtime — minimal image with WRF binaries only
# =============================================================================
FROM ${BASE_IMAGE} AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# Install runtime libraries only (no build toolchain)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnetcdff7 \
    libhdf5-103-1 \
    libpng16-16 \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Copy WRF executables from builder
COPY --from=builder /build/WRF/main/wrf.exe /wrf/main/
COPY --from=builder /build/WRF/main/real.exe /wrf/main/
COPY --from=builder /build/WRF/main/ndown.exe /wrf/main/
COPY --from=builder /build/WRF/main/tc.exe /wrf/main/

# Copy WRF run directory (contains required data tables, etc.)
COPY --from=builder /build/WRF/run/ /wrf/run/

# Copy healthcheck script
COPY healthcheck-wrf.sh /usr/local/bin/healthcheck-wrf.sh
RUN chmod +x /usr/local/bin/healthcheck-wrf.sh

WORKDIR /wrf

# Create data directories
RUN mkdir -p /data/input /data/output

ENV PATH="/wrf/main:/wrf/run:${PATH}"

HEALTHCHECK --interval=60s --timeout=10s --retries=3 \
    CMD /usr/local/bin/healthcheck-wrf.sh --wrf

# Run as non-root user
RUN useradd -m -s /bin/bash wrfuser && chown -R wrfuser:wrfuser /wrf /data
USER wrfuser

ENTRYPOINT ["/bin/bash"]
