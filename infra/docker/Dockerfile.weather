# Wrfcoin Weather Service — multi-stage build
# Stage 1: install native npm modules with build tools
FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS builder

WORKDIR /app

RUN apk add --no-cache python3 make g++

COPY package*.json ./
RUN npm install --omit=dev --legacy-peer-deps

# Stage 2: runtime image — no build tools
FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1

WORKDIR /app

RUN apk add --no-cache curl

# Create non-root user
RUN addgroup -g 1001 -S wrfcoin && \
    adduser -S wrfcoin -u 1001

# Copy only production node_modules from builder
COPY --from=builder /app/node_modules ./node_modules

# Copy weather service specific code with proper ownership
COPY --chown=wrfcoin:wrfcoin backend/server/ ./server/
COPY --chown=wrfcoin:wrfcoin backend/utils/ ./server/utils/
COPY --chown=wrfcoin:wrfcoin backend/shared/ ./shared/
COPY --chown=wrfcoin:wrfcoin backend/services/weather/ ./src/weather/

USER wrfcoin

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

CMD ["node", "server/services/weather-service-server.js"]
