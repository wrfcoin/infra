&share
 wrf_core = 'ARW',
 max_dom = 1,
 start_date = '2024-01-01_00:00:00',
 end_date   = '2024-01-01_06:00:00',
 interval_seconds = 21600,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         = 1,
 parent_grid_ratio = 1,
 i_parent_start    = 1,
 j_parent_start    = 1,
 e_we              = 50,
 e_sn              = 50,
 geog_data_res     = 'default',
 dx = 10000,
 dy = 10000,
 map_proj = 'lambert',
 ref_lat   =  40.0,
 ref_lon   = -98.0,
 truelat1  =  30.0,
 truelat2  =  50.0,
 stand_lon = -98.0,
 geog_data_path = '/data/geog/',
/

&ungrib
 out_format = 'WPS',
 prefix = 'FILE',
/

&metgrid
 fg_name = 'FILE',
 io_form_metgrid = 2,
/
