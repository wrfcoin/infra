# node:20-slim
FROM node:24-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205

WORKDIR /app

COPY infra/compute-agent/package*.json ./
RUN npm ci --production

COPY infra/compute-agent/dist/ ./dist/

# Working directory for WRF task data
VOLUME ["/work"]

# Wallet key mount point
VOLUME ["/keys"]

# Non-root user matching core4 convention (UID 1001, core4#664)
RUN groupadd -g 1001 wrfcoin && \
    useradd -m -u 1001 -g wrfcoin wrfcoin && \
    chown -R wrfcoin:wrfcoin /app

HEALTHCHECK --interval=30s --timeout=5s \
  CMD node -e "fetch('http://localhost:3333/health').then(r => r.ok || process.exit(1)).catch(() => process.exit(1))"

USER wrfcoin

CMD ["node", "dist/index.js"]
