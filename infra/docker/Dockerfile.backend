# WRFCoin Backend API (Node.js)
# Multi-stage build for the testnet backend service.
#
# All testnet server entry points are bundled with esbuild into self-contained
# CJS files under dist/. Only native modules that esbuild cannot bundle are
# copied to the runtime image, keeping it slim (~50 MB vs ~500 MB with full
# node_modules). Per-service and subset builds are also supported by
# `esbuild-backend.sh`.
#
# Build context must be the workspace root (wrfcoin/) so that
# COPY backend/ captures the full backend directory.

# =============================================================================
# Stage 1: Builder — install deps, bundle all entry points with esbuild
# =============================================================================
# node:20-alpine
FROM node:24-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS builder

WORKDIR /app

# Install system dependencies needed for native modules
RUN apk add --no-cache python3 make g++ git

# Copy root workspace package files (needed for workspace resolution)
COPY package*.json ./

# Copy backend package files for dependency install
COPY backend/package*.json ./backend/

# infra#1113 (owner ruling 2026-09-27): never download onnxruntime-node's GPU
# (CUDA/TensorRT) providers. On linux/x64 (node:24-alpine reports linux/x64)
# its postinstall otherwise fetches the ~238 MB Microsoft.ML.OnnxRuntime.Gpu.Linux
# NuGet package on every install. They are glibc CUDA libraries that cannot
# load on musl, and no WRFCoin host has a GPU. The CPU runtime is bundled.
# ENV rather than COPY backend/.npmrc so the build does not depend on merge
# order with backend#1278. Build stage only: the runtime stage never installs.
ENV ONNXRUNTIME_NODE_INSTALL=skip

# Install dependencies from the backend directory
# Use npm install (not npm ci) — the lock file may drift between
# transitive @aws-sdk/@smithy patch versions across npm minor versions.
WORKDIR /app/backend
RUN npm install

# Copy backend source code
WORKDIR /app
COPY backend/ ./backend/
COPY infra/infra/docker/esbuild-backend.sh /tmp/esbuild-backend.sh
COPY infra/infra/docker/build.mjs /tmp/build.mjs

# Build with esbuild (handles CJS/ESM interop)
WORKDIR /app/backend

# Remove stale .js files where .ts source exists (prevents esbuild misresolution)
RUN find . -name '*.js' -not -path './node_modules/*' -not -path './dist/*' | \
    while read f; do ts="${f%.js}.ts"; [ -f "$ts" ] && rm "$f" && echo "removed $f"; done; true

# Pin esbuild to an exact version: its handling of createRequire-produced
# require(<local literal>) calls (i.e. whether a relative specifier is bundled
# or externalized) is version-dependent. An exact pin keeps externalize
# behavior deterministic so a broken relative require can't silently ship.
RUN npm install --save-dev esbuild@0.28.0
RUN sh /tmp/esbuild-backend.sh

# =============================================================================
# Stage 2: Pruner — extract only the externalized native modules
# =============================================================================
# node:20-alpine
FROM node:24-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS pruner

WORKDIR /app
COPY --from=builder /app/backend/dist/externals.txt /tmp/externals.txt
COPY --from=builder /app/backend/node_modules ./node_modules/

# Copy only the externalized packages and ALL transitive deps into /app/keep.
# We iterate up to 5 rounds to resolve deep transitive chains (e.g. jsdom →
# … → tldts) that a single-pass copy would miss.
# db-migrate runs drizzle-kit against drizzle.config.ts in the runtime image,
# so keep migration-time packages even if esbuild bundles do not externalize
# them.
RUN set -e && \
    mkdir -p /app/keep && \
    printf '%s\n' dotenv drizzle-kit drizzle-orm pg >> /tmp/externals.txt && \
    while IFS= read -r pkg; do \
      [ -z "$pkg" ] && continue; \
      if [ -d "node_modules/$pkg" ]; then \
        dir=$(dirname "keep/$pkg"); \
        mkdir -p "$dir"; \
        cp -r "node_modules/$pkg" "$dir/"; \
      fi; \
    done < /tmp/externals.txt && \
    round=0 && \
    while [ "$round" -lt 5 ]; do \
      added=0; \
      for pj in $(find /app/keep -name package.json -maxdepth 3 2>/dev/null); do \
        for d in $(node -e " \
          const p = JSON.parse(require('fs').readFileSync('$pj','utf8')); \
          Object.keys(p.dependencies || {}).forEach(d => console.log(d));" 2>/dev/null); do \
          if [ -d "/app/node_modules/$d" ] && [ ! -d "/app/keep/$d" ]; then \
            dir=$(dirname "keep/$d"); \
            mkdir -p "/app/$dir"; \
            cp -r "/app/node_modules/$d" "/app/$dir/"; \
            added=$((added + 1)); \
          fi; \
        done; \
      done; \
      [ "$added" -eq 0 ] && break; \
      round=$((round + 1)); \
    done && \
    echo "Pruned node_modules ($(ls /app/keep/ 2>/dev/null | wc -l) packages):" && \
    ls /app/keep/ 2>/dev/null || echo "(empty — fully self-contained)"

# =============================================================================
# Stage 3: Runtime — slim image with only bundles + externals
# =============================================================================
# node:20-alpine
FROM node:24-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS runtime

# Release provenance (infra#991): source testnet/scripts/export-build-provenance.sh
# before a release build. Unset args leave empty labels, which
# render-release-manifest.sh classifies UNAVAILABLE (never FRESH). No build-time
# guard: joiner, attester and CI builds pass no args and must keep building.
ARG WRFCOIN_BUILD_REVISION
ARG WRFCOIN_BUILD_CREATED
LABEL org.opencontainers.image.revision="$WRFCOIN_BUILD_REVISION" \
      org.opencontainers.image.created="$WRFCOIN_BUILD_CREATED"
ENV WRFCOIN_BUILD_REVISION="$WRFCOIN_BUILD_REVISION" \
    WRFCOIN_BUILD_CREATED="$WRFCOIN_BUILD_CREATED"

WORKDIR /app/backend

RUN apk add --no-cache curl

# Copy bundled CJS output (all testnet entry points)
COPY --from=builder /app/backend/dist ./dist/
# Copy only externalized native modules (not the full ~1.2GB node_modules).
# The pruner now iterates transitive deps to catch packages like tldts.
COPY --from=pruner /app/keep ./node_modules/
COPY --from=builder /app/backend/package.json ./

# Drizzle migration files for db-migrate init container
COPY --from=builder /app/backend/drizzle ./drizzle/
COPY --from=builder /app/backend/drizzle.config.ts ./
COPY infra/infra/docker/assert-migration-image-freshness.sh /usr/local/bin/assert-migration-image-freshness

# Remove "type": "module" so Node.js runs the CJS bundles correctly
RUN sed -i '/"type": "module"/d' package.json && \
    chmod +x /usr/local/bin/assert-migration-image-freshness

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S wrfcoin -u 1001 -G nodejs && \
    mkdir -p /app/weather-archive && \
    chown -R wrfcoin:nodejs /app

USER wrfcoin

EXPOSE 4001

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:${PORT:-4001}/health || exit 1

CMD ["node", "dist/server.cjs"]
