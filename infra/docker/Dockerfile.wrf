# Dockerfile.wrf — WRF-ARW (Weather Research and Forecasting) container
# Multi-stage build for WRF 4.5.2 with gfortran + dmpar (distributed memory parallel)
#
# Build time: ~30-45 minutes depending on hardware (WRF compilation is intensive)
# Final image size: ~1.5-2GB
#
# Usage:
#   docker build -f Dockerfile.wrf -t wrfcoin/wrf:4.5.2 .
#   docker run -v wps-output:/data/input -v wrf-output:/data/output wrfcoin/wrf:4.5.2

ARG WRF_VERSION=4.5.2
ARG BASE_IMAGE=ubuntu:22.04@sha256:962f6cadeae0ea6284001009daa4cc9a8c37e75d1f5191cf0eb83fe565b63dd7
# Pinned SHA256 for the WRF v4.5.2 source tarball from GitHub Releases.
# See infra/docker/wrf/SHA256SUMS.txt for the current pinned values.
ARG WRF_SHA256=8906da9e90dbfb6b3d617483c2dceae133600844b22f802e7eab31a1bb5cd48d

# =============================================================================
# Stage 1: Builder — compile WRF from source
# =============================================================================
FROM ${BASE_IMAGE} AS builder

ARG WRF_VERSION
ARG WRF_SHA256

ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gfortran \
    cpp \
    gcc \
    g++ \
    m4 \
    make \
    wget \
    ca-certificates \
    libnetcdf-dev \
    libnetcdff-dev \
    libhdf5-dev \
    libjasper-dev \
    libpng-dev \
    zlib1g-dev \
    mpich \
    libmpich-dev \
    csh \
    tcsh \
    perl \
    file \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables for WRF build
ENV NETCDF=/usr
ENV HDF5=/usr
ENV JASPERLIB=/usr/lib
ENV JASPERINC=/usr/include
ENV WRF_DIR=/build/WRF
ENV WRFIO_NCD_LARGE_FILE_SUPPORT=1

WORKDIR /build

# Download WRF source and verify the pinned SHA256 checksum.
RUN wget -q "https://github.com/wrf-model/WRF/archive/refs/tags/v${WRF_VERSION}.tar.gz" \
    -O wrf.tar.gz \
    && echo "${WRF_SHA256}  wrf.tar.gz" | sha256sum -c - \
    && tar xzf wrf.tar.gz \
    && rm wrf.tar.gz \
    && mv WRF-${WRF_VERSION} WRF

WORKDIR /build/WRF

# Configure WRF for dmpar (distributed memory parallel) with gfortran
# Option 34 = dmpar gfortran on Linux x86_64
# Second input "1" selects basic nesting
RUN printf "34\n1\n" | ./configure

# Verify dmpar was configured correctly
RUN grep -q "DM_PARALLEL" configure.wrf || (echo "ERROR: dmpar not configured" && exit 1)

# Compile WRF em_real case
# NOTE: This step takes 30+ minutes. Use Docker layer caching to avoid rebuilds.
RUN ./compile em_real 2>&1 | tee /build/compile_wrf.log \
    && ls -la main/wrf.exe main/real.exe main/ndown.exe main/tc.exe

# =============================================================================
# Stage 2: Runtime — minimal image with WRF binaries
# =============================================================================
FROM ${BASE_IMAGE} AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# Install runtime libraries only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnetcdff7 \
    libhdf5-103-1 \
    libjasper4 \
    libpng16-16 \
    mpich \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Copy WRF executables from builder
COPY --from=builder /build/WRF/main/wrf.exe /wrf/
COPY --from=builder /build/WRF/main/real.exe /wrf/
COPY --from=builder /build/WRF/main/ndown.exe /wrf/
COPY --from=builder /build/WRF/main/tc.exe /wrf/

# Copy WRF run directory (contains required data tables, etc.)
COPY --from=builder /build/WRF/run/ /wrf/run/

# Copy healthcheck script
COPY healthcheck-wrf.sh /usr/local/bin/healthcheck-wrf.sh
RUN chmod +x /usr/local/bin/healthcheck-wrf.sh

# Copy sample namelist
COPY namelist.input /wrf/run/namelist.input.sample

WORKDIR /wrf

# Create data directories
RUN mkdir -p /data/input /data/output

VOLUME ["/data/input", "/data/output"]

# Set PATH to include WRF executables
ENV PATH="/wrf:/wrf/run:${PATH}"

HEALTHCHECK --interval=60s --timeout=10s --retries=3 \
    CMD /usr/local/bin/healthcheck-wrf.sh --wrf

# Run as non-root user
RUN useradd -m -s /bin/bash wrfuser && chown -R wrfuser:wrfuser /wrf /data
USER wrfuser

ENTRYPOINT ["/bin/bash"]
