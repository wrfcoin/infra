# Wrfcoin ETL Pipeline Service — multi-stage build
# Stage 1: install native npm modules with build tools
FROM node:24-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS builder

WORKDIR /app

RUN apk add --no-cache python3 make g++

COPY package*.json ./
RUN npm install --omit=dev --legacy-peer-deps

# Stage 2: runtime image — no build tools
FROM node:24-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53

WORKDIR /app

RUN apk add --no-cache curl

# Create non-root user
RUN addgroup -g 1001 -S wrfcoin && \
    adduser -S wrfcoin -u 1001

# Copy only production node_modules from builder
COPY --from=builder /app/node_modules ./node_modules

# Copy ETL specific code with proper ownership
COPY --chown=wrfcoin:wrfcoin backend/services/etl/ ./src/etl/
COPY --chown=wrfcoin:wrfcoin backend/src/node_os/etl_framework.js ./src/node_os/
# backend#1236: pipeline_server.js requires ../../server/utils/strict-cors-config
# (production refuses an empty/loopback/wildcard CORS_ORIGIN). Ship it at the
# same relative path as in the backend repo.
COPY --chown=wrfcoin:wrfcoin backend/server/utils/strict-cors-config.js ./server/utils/strict-cors-config.js

USER wrfcoin

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:5000/health || exit 1

CMD ["node", "src/etl/pipeline_server.js"]
