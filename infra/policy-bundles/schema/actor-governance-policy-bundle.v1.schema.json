{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wrfcoin.org/schemas/actor-governance-policy-bundle.v1.schema.json",
  "title": "WRFCoin Actor Governance Policy Bundle",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "policy_bundle_version",
    "created_at",
    "actor_classes",
    "sanction_profiles",
    "equal_liability_matrix",
    "rollout",
    "rollback"
  ],
  "properties": {
    "schema_id": {
      "const": "wrfcoin.actor_governance_policy_bundle"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "policy_bundle_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_classes": {
      "type": "object"
    },
    "sanction_profiles": {
      "type": "object"
    },
    "equal_liability_matrix": {
      "type": "object"
    },
    "rollout": {
      "type": "object"
    },
    "rollback": {
      "type": "object"
    },
    "change_log": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
